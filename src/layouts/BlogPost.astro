---
import BaseLayout from "./BaseLayout.astro";
import { SITE, LOCALE_TAG, type Locale } from "../consts";

interface Props {
  title: string;
  description: string;
  pubDate: Date;
  updatedDate?: Date;
  tags?: string[];
  heroImage?: string;
  locale: Locale;
  /** Path without locale prefix, e.g. "/blog/lora-deep-dive/" */
  path: string;
}

const { title, description, pubDate, updatedDate, tags = [], heroImage, locale, path } =
  Astro.props;

const fmt = (d: Date) =>
  d.toLocaleDateString(LOCALE_TAG[locale], {
    year: "numeric",
    month: "long",
    day: "numeric",
  });

const authorName = locale === "ko" ? SITE.authorKo : SITE.author;

// BlogPosting structured data — lets answer engines cite the article + author.
const articleLd = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  headline: title,
  description,
  datePublished: pubDate.toISOString(),
  ...(updatedDate ? { dateModified: updatedDate.toISOString() } : {}),
  author: { "@type": "Person", name: authorName, url: SITE.url },
  publisher: { "@type": "Person", name: authorName, url: SITE.url },
  ...(heroImage ? { image: new URL(heroImage, SITE.url).href } : {}),
  ...(tags.length ? { keywords: tags.join(", ") } : {}),
  inLanguage: LOCALE_TAG[locale],
  mainEntityOfPage: new URL(locale === "ko" ? path : `/en${path}`, SITE.url).href,
};
---

<BaseLayout
  title={`${title} — ${SITE.author}`}
  description={description}
  locale={locale}
  path={path}
  image={heroImage}
  ogType="article"
  jsonLd={[articleLd]}
>
  <article>
    <header class="mb-10 border-b border-border pb-8">
      <a href={locale === "ko" ? "/blog/" : "/en/blog/"} class="text-sm text-muted hover:text-accent">
        ← {locale === "ko" ? "블로그" : "Blog"}
      </a>
      <h1 class="mt-4 text-3xl font-bold leading-tight tracking-tight sm:text-4xl">
        {title}
      </h1>
      <div class="mt-4 flex flex-wrap items-center gap-x-3 gap-y-1 text-sm text-muted">
        <time datetime={pubDate.toISOString()}>{fmt(pubDate)}</time>
        {
          tags.map((tag) => (
            <span class="text-accent">#{tag}</span>
          ))
        }
      </div>
    </header>

    <div class="prose prose-zinc max-w-none dark:prose-invert prose-headings:tracking-tight prose-a:text-accent prose-img:rounded-lg prose-img:border prose-img:border-border">
      <slot />
    </div>
  </article>
</BaseLayout>
