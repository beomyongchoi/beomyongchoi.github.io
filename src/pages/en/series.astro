---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { SITE } from "../../consts";
import { SERIES } from "../../data/series";

const ORDER = ["linalg", "transformer"];
const list = ORDER.map((id) => ({ id, s: SERIES[id] })).filter((x) => x.s);
---

<BaseLayout
  title={`Series — ${SITE.author}`}
  description="Post + interactive-lab bundles. Read from the linear-algebra floor up through the transformer's internals to understand how LLMs actually work."
  locale="en"
  path="/series/"
>
  <header class="mb-10">
    <h1 class="text-3xl font-bold tracking-tight sm:text-4xl">Series</h1>
    <p class="mt-3 text-muted">
      Each part pairs one post with one lab toy. Read <strong>Thinking in Matrices → Taking the Transformer Apart</strong>
      and you go from vectors to GPT, bottom up.
    </p>
  </header>

  {
    list.map(({ id, s }, si) => (
      <section class="sr-series">
        <div class="sr-head">
          <h2>📚 {s.title.en}</h2>
          {si === 0 && <span class="sr-start">start here</span>}
        </div>
        <p class="sr-blurb">{s.blurb.en}</p>
        <ol class="sr-parts">
          {s.parts.map((p) => (
            <li>
              <a class="sr-post" href={`/en/blog/${p.slug}/`}>{p.title.en}</a>
              {p.toy && <a class="sr-toy" href={p.toy}>🧪 lab</a>}
            </li>
          ))}
        </ol>
      </section>
    ))
  }

  <p class="sr-foot">
    Non-series posts live in the <a href="/en/blog/">blog</a>; all toys in the <a href="/playground/">playground</a>.
  </p>
</BaseLayout>

<style>
  .sr-series { margin-bottom: 40px; border: 1px solid var(--border); border-radius: 14px; padding: 22px 24px; background: var(--surface); }
  .sr-head { display: flex; align-items: center; gap: 10px; }
  .sr-head h2 { font-size: 1.25rem; font-weight: 700; }
  .sr-start { font-size: 0.68rem; font-weight: 700; font-family: var(--font-mono); color: var(--accent-fg); background: var(--accent); border-radius: 999px; padding: 2px 10px; }
  .sr-blurb { margin-top: 6px; font-size: 0.9rem; color: var(--muted); line-height: 1.6; }
  .sr-parts { list-style: none; margin: 16px 0 0; padding: 0; display: flex; flex-direction: column; }
  .sr-parts li { display: flex; align-items: baseline; justify-content: space-between; gap: 12px; padding: 9px 2px; border-top: 1px solid var(--border); }
  .sr-post { font-family: var(--font-mono); font-size: 0.95rem; color: var(--fg); text-decoration: none; }
  .sr-post:hover { color: var(--accent); text-decoration: underline; }
  .sr-toy { flex-shrink: 0; font-family: var(--font-mono); font-size: 0.78rem; color: var(--accent); text-decoration: none; }
  .sr-toy:hover { text-decoration: underline; }
  .sr-foot { font-size: 0.88rem; color: var(--muted); }
  .sr-foot a { color: var(--accent); }
</style>
