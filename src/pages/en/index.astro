---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { T } from "../../consts";
const s = T.en;
---

<BaseLayout title={s.title} description={s.description} locale="en" path="/">
  <section class="py-8">
    <p class="text-sm font-medium text-accent">{s.role}</p>
    <h1 class="mt-3 text-3xl font-bold tracking-tight sm:text-4xl">
      {s.tagline}
    </h1>
    <p class="mt-5 max-w-xl text-lg leading-relaxed text-muted">
      {s.description}
    </p>
  </section>

  <section class="mt-12 rounded-xl border border-border bg-surface px-6 py-8">
    <h2 class="text-lg font-semibold">{s.wipTitle}</h2>
    <p class="mt-2 text-muted">{s.wipBody}</p>
  </section>
</BaseLayout>
