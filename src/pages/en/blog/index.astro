---
import { getCollection } from "astro:content";
import BaseLayout from "../../../layouts/BaseLayout.astro";
import PostList from "../../../components/PostList.astro";
import { SITE } from "../../../consts";

const posts = (
  await getCollection("blog", (p) => p.data.lang === "en" && !p.data.draft)
).sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const items = posts.map((p) => ({
  href: `/en/blog/${p.data.translationKey ?? p.id}/`,
  title: p.data.title,
  description: p.data.description,
  pubDate: p.data.pubDate,
  tags: p.data.tags,
}));
---

<BaseLayout
  title={`Blog — ${SITE.author}`}
  description="Notes on AI, AEO, and backend engineering — what I learn and figure out."
  locale="en"
  path="/blog/"
>
  <header class="mb-10">
    <h1 class="text-3xl font-bold tracking-tight sm:text-4xl">Blog</h1>
    <p class="mt-3 text-muted">Notes on AI, AEO, and backend engineering — what I learn and figure out.</p>
  </header>
  <PostList posts={items} locale="en" emptyText="No posts yet. Korean posts are being translated." />
</BaseLayout>
