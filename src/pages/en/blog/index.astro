---
import { getCollection } from "astro:content";
import BaseLayout from "../../../layouts/BaseLayout.astro";
import PostList from "../../../components/PostList.astro";
import { SITE } from "../../../consts";
import { seriesOf } from "../../../data/series";

const posts = (
  await getCollection("blog", (p) => p.data.lang === "en" && !p.data.draft)
).sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const badge = (slug: string) => {
  const hit = seriesOf(slug);
  if (!hit) return undefined;
  const i = hit.series.parts.findIndex((pt) => pt.slug === slug);
  return `${hit.series.title.en} · Part ${i}`;
};

const items = posts.map((p) => ({
  href: `/en/blog/${p.data.translationKey ?? p.id}/`,
  title: p.data.title,
  description: p.data.description,
  pubDate: p.data.pubDate,
  tags: p.data.tags,
  seriesBadge: badge(p.data.translationKey ?? p.id),
}));
---

<BaseLayout
  title={`Blog — ${SITE.author}`}
  description="Mostly AI and backend — but I write up whatever I happen to be digging into."
  locale="en"
  path="/blog/"
>
  <header class="mb-10">
    <h1 class="text-3xl font-bold tracking-tight sm:text-4xl">Blog</h1>
    <p class="mt-3 text-muted">Mostly AI and backend — but I write up whatever I happen to be digging into.</p>
  </header>
  <PostList posts={items} locale="en" emptyText="No posts yet. Korean posts are being translated." />
</BaseLayout>
