---
import ArcTitle from "../../../components/ArcTitle.astro";
import BaseLayout from "../../../layouts/BaseLayout.astro";
import WorkGrid from "../../../components/WorkGrid.astro";
import { SITE } from "../../../consts";
---

<BaseLayout
  title={`Work — ${SITE.author}`}
  description="From an AEO measurement platform to hotel-operations SaaS and AI-friendly content infra — recent work."
  locale="en"
  path="/work/"
>
  <header class="mb-10 text-center">
    <ArcTitle text="Work" />
    <p class="mx-auto mt-2 max-w-xl text-balance text-muted">
      From an AEO measurement platform to hotel-operations SaaS and AI-friendly content infra — recent work.
    </p>
  </header>
  <WorkGrid locale="en" />
</BaseLayout>
