---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { SITE } from "../../consts";
---

<BaseLayout
  title={`About — ${SITE.author}`}
  description="Backend to AI. I'd rather prove things by building them — solve the problem first, then write the code, and work end to end."
  locale="en"
  path="/about/"
  ogType="profile"
>
  <div class="prose prose-zinc max-w-none dark:prose-invert prose-headings:tracking-tight prose-a:text-accent">
    <h1>About</h1>

    <blockquote class="lead-quote">
      “Talk is cheap. Show me the code.”
      <cite>— Linus Torvalds</cite>
    </blockquote>

    <p>I'm a backend engineer. Now I build AI.</p>

    <p>
      I'd rather prove things by building them. Solve the problem first, then write the code. I work
      end to end — from design to running it in production.
    </p>

    <p>When something new shows up, I take it apart to see how it works. Watching LLMs change search pulled me into AI.</p>

    <p class="links">
      Want the details? — <a href="/en/resume/">Resume</a> · <a href="/en/work/">Work</a> ·
      <a href={`mailto:${SITE.email}`}>Email</a> · <a href={SITE.linkedin}>LinkedIn</a>
    </p>
  </div>
</BaseLayout>

<style>
  .lead-quote {
    margin: 1.6rem 0 2.2rem;
    padding-left: 1.1rem;
    border-left: 3px solid var(--accent);
    font-size: 1.5rem;
    line-height: 1.45;
    font-weight: 600;
    font-style: normal;
    color: var(--fg);
    quotes: none;
  }
  .lead-quote cite {
    display: block;
    margin-top: 0.6rem;
    font-size: 0.95rem;
    font-weight: 500;
    font-style: normal;
    color: var(--muted);
  }
  .links {
    color: var(--muted);
    font-size: 0.95rem;
  }
</style>
