---
import BaseLayout from "../../layouts/BaseLayout.astro";
import WorkGrid from "../../components/WorkGrid.astro";
import { SITE } from "../../consts";
---

<BaseLayout
  title={`작업 — ${SITE.authorKo}`}
  description="AEO 측정 플랫폼부터 호텔 운영 SaaS, AI 친화 콘텐츠 인프라까지 — 최근 작업들입니다."
  locale="ko"
  path="/work/"
>
  <header class="mb-10">
    <h1 class="text-3xl font-bold tracking-tight sm:text-4xl">작업</h1>
    <p class="mt-3 text-muted">
      AEO 측정 플랫폼부터 호텔 운영 SaaS, AI 친화 콘텐츠 인프라까지 — 최근 작업들입니다.
    </p>
  </header>
  <WorkGrid locale="ko" />
</BaseLayout>
