---
import ArcTitle from "../../components/ArcTitle.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import WorkGrid from "../../components/WorkGrid.astro";
import { SITE } from "../../consts";
---

<BaseLayout
  title={`작업 — ${SITE.authorKo}`}
  description="AEO 측정 플랫폼부터 호텔 운영 SaaS, AI 친화 콘텐츠 인프라까지 — 최근 작업들입니다."
  locale="ko"
  path="/work/"
>
  <header class="mb-10 text-center">
    <ArcTitle text="작업" />
    <p class="mx-auto mt-2 max-w-xl text-balance text-muted">
      AEO 측정 플랫폼부터 호텔 운영 SaaS, AI 친화 콘텐츠 인프라까지 — 최근 작업들입니다.
    </p>
  </header>
  <WorkGrid locale="ko" />
</BaseLayout>
