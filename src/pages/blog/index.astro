---
import ArcTitle from "../../components/ArcTitle.astro";
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import PostList from "../../components/PostList.astro";
import { SITE } from "../../consts";
import { seriesOf } from "../../data/series";

const posts = (
  await getCollection("blog", (p) => p.data.lang === "ko" && !p.data.draft)
).sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const badge = (slug: string) => {
  const hit = seriesOf(slug);
  if (!hit) return undefined;
  const i = hit.series.parts.findIndex((pt) => pt.slug === slug);
  return `${hit.series.title.ko} · ${i}편`;
};

const items = posts.map((p) => ({
  href: `/blog/${p.id}/`,
  title: p.data.title,
  description: p.data.description,
  pubDate: p.data.pubDate,
  tags: p.data.tags,
  seriesBadge: badge(p.id),
}));
---

<BaseLayout
  title={`블로그 — ${SITE.authorKo}`}
  description="AI와 백엔드를 주로 다루지만, 그때그때 관심 가는 건 뭐든 배우고 정리합니다."
  locale="ko"
  path="/blog/"
>
  <header class="mb-10 text-center">
    <ArcTitle text="블로그" />
    <p class="mx-auto mt-2 max-w-xl text-balance text-muted">AI와 백엔드를 주로 다루지만, 그때그때 관심 가는 건 뭐든 배우고 정리합니다.</p>
  </header>
  <PostList posts={items} locale="ko" emptyText="아직 글이 없습니다." />
</BaseLayout>
