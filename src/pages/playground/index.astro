    const cs = getComputedStyle(document.documentElement);
    ctx.fillStyle = cs.getPropertyValue("--surface").trim() || "#f2f3f5"; ctx.fillRect(0, 0, W, H);
    const acc = cs.getPropertyValue("--accent").trim() || "#2b4a7e", grn = "#22a06b";
    const border = cs.getPropertyValue("--border").trim() || "#e5e6e9";
    const x0 = 22, x1 = W - 22, ymin = H - 24, ytop = 16, mid = (x0 + x1) / 2;
    // parabola with the valley at bottom-center (screen y grows downward)
    const Y = (x) => ymin - (ymin - ytop) * ((x - mid) / (x1 - mid)) ** 2;
    ctx.strokeStyle = border; ctx.lineWidth = 1;
    ctx.beginPath(); ctx.moveTo(x0 - 4, ymin + 4); ctx.lineTo(x1 + 4, ymin + 4); ctx.stroke();
    ctx.strokeStyle = acc; ctx.lineWidth = 2.2; ctx.beginPath();
    for (let x = x0; x <= x1; x += 3) { const y = Y(x); x === x0 ? ctx.moveTo(x, y) : ctx.lineTo(x, y); }
    ctx.stroke();
    ctx.fillStyle = grn; ctx.beginPath(); ctx.arc(mid, Y(mid), 3, 0, 7); ctx.fill();
    // discrete hops: geometric approach from the right side, looping
    const HOPS = 5, phase = Math.floor(f / 40) % (HOPS + 2);
    let px = null, py = null;
    ctx.strokeStyle = acc;
    for (let i = 0; i <= Math.min(phase, HOPS); i++) {
      const t = 0.85 * Math.pow(0.55, i);           // fraction of half-width from valley
      const x = mid + t * (x1 - mid), y = Y(x);
      if (px !== null) {
        ctx.globalAlpha = 0.5; ctx.setLineDash([3, 3]); ctx.lineWidth = 1.2;
        ctx.beginPath(); ctx.moveTo(px, py); ctx.quadraticCurveTo((px + x) / 2, Math.min(py, y) - 16, x, y); ctx.stroke();
        ctx.setLineDash([]); ctx.globalAlpha = 1;
      }
      ctx.fillStyle = i === Math.min(phase, HOPS) ? acc : "rgba(43,74,126,0.35)";
      ctx.beginPath(); ctx.arc(x, y, i === Math.min(phase, HOPS) ? 5 : 3.5, 0, 7); ctx.fill();
      if (i === Math.min(phase, HOPS)) { ctx.strokeStyle = "#fff"; ctx.lineWidth = 1.8; ctx.stroke(); ctx.strokeStyle = acc; }
      px = x; py = y;
    }
  }

  function thinkingeffort(ctx, W, H, f) {
    const cs = getComputedStyle(document.documentElement);
    ctx.fillStyle = cs.getPropertyValue("--surface").trim() || "#f2f3f5"; ctx.fillRect(0, 0, W, H);
    const acc = cs.getPropertyValue("--accent").trim() || "#2b4a7e", grn = "#22a06b";
    const bars = [0.3, 0.6, 0.95];
    const active = Math.floor(f / 40) % 3;
    bars.forEach((b, i) => {
      const y = 24 + i * 28;
      ctx.fillStyle = i === active ? grn : acc;
      ctx.globalAlpha = i === active ? 0.9 : 0.3;
      ctx.beginPath(); ctx.roundRect(30, y, (W - 60) * b, 14, 4); ctx.fill();
    });
    ctx.globalAlpha = 1;
  }

  function agenttopology(ctx, W, H, f) {
    const cs = getComputedStyle(document.documentElement);
    ctx.fillStyle = cs.getPropertyValue("--surface").trim() || "#f2f3f5"; ctx.fillRect(0, 0, W, H);
    const acc = cs.getPropertyValue("--accent").trim() || "#2b4a7e", grn = "#22a06b";
    const mx = 30, my = H / 2;
    const subs = [{ x: W - 40, y: 22 }, { x: W - 40, y: H / 2 }, { x: W - 40, y: H - 22 }];
    const pulse = 0.5 + 0.5 * Math.sin(f * 0.08);
    subs.forEach(s => {
      ctx.strokeStyle = acc; ctx.lineWidth = 1.8; ctx.globalAlpha = 0.4 + 0.4 * pulse;
      ctx.beginPath(); ctx.moveTo(mx, my); ctx.bezierCurveTo((mx + s.x) / 2, my, (mx + s.x) / 2, s.y, s.x, s.y); ctx.stroke();
      ctx.fillStyle = grn; ctx.globalAlpha = 1;
      ctx.beginPath(); ctx.arc(s.x, s.y, 4, 0, 7); ctx.fill();
    });
    ctx.fillStyle = acc; ctx.beginPath(); ctx.arc(mx, my, 7, 0, 7); ctx.fill();
  }

  function longhorizon(ctx, W, H, f) {
    const cs = getComputedStyle(document.documentElement);
    ctx.fillStyle = cs.getPropertyValue("--surface").trim() || "#f2f3f5"; ctx.fillRect(0, 0, W, H);
    const acc = cs.getPropertyValue("--accent").trim() || "#2b4a7e", grn = "#22a06b";
    const progress = (f % 120) / 120;
    ctx.fillStyle = "#292e42"; ctx.fillRect(20, H / 2 - 8, W - 40, 16);
    ctx.fillStyle = grn; ctx.fillRect(20, H / 2 - 8, (W - 40) * progress, 16);
    ctx.strokeStyle = acc; ctx.lineWidth = 2; ctx.strokeRect(20, H / 2 - 8, W - 40, 16);
  }

  function agentcompare(ctx, W, H, f) {
    const cs = getComputedStyle(document.documentElement);
    ctx.fillStyle = cs.getPropertyValue("--surface").trim() || "#f2f3f5"; ctx.fillRect(0, 0, W, H);
    const acc = cs.getPropertyValue("--accent").trim() || "#2b4a7e", grn = "#22a06b";
    const toggle = Math.floor(f / 60) % 2;
    ctx.fillStyle = toggle === 0 ? acc : grn;
    ctx.beginPath(); ctx.roundRect(W / 4 - 20, H / 2 - 15, 40, 30, 6); ctx.fill();
    ctx.fillStyle = toggle === 1 ? acc : grn;
    ctx.beginPath(); ctx.roundRect((W * 3) / 4 - 20, H / 2 - 15, 40, 30, 6); ctx.fill();
  }

  const FN = { vectors, matmul, linearmap, neurallayer, loss, gradient, backprop, train, lotto, transformer, fanout, transformerblock, bert, gpt, sampling, rag, arch, rope, depth, kv, moe, embeddings, thinkingeffort, agenttopology, longhorizon, agentcompare };
  let f = 0;
  function loop() {
    f++;
    for (const t of thumbs) if (FN[t.toy]) FN[t.toy](t.ctx, t.W, t.H, f);
    requestAnimationFrame(loop);
  }
  loop();
</script>
