---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { SITE } from "../../consts";
---

<BaseLayout
  title={`실험실 — ${SITE.authorKo}`}
  description="블로그 곁에서 굴려보는 소소한 사이드 프로젝트들. 8비트 마리오 ? 블록 로또 추첨기."
  locale="ko"
  path="/playground/"
>
  <header class="mb-10">
    <h1 class="text-3xl font-bold tracking-tight sm:text-4xl">실험실</h1>
    <p class="mt-3 text-muted">블로그 곁에서 굴려보는 소소한 것들. Canvas·JS로 직접 만든 장난감.</p>
  </header>

  <section class="lab-card">
    <div class="lab-head">
      <h2>LUCKY BLOCK <span class="badge">로또 6 / 45</span></h2>
      <span class="lab-tag">Canvas 2D · 8-bit</span>
    </div>

    <canvas id="lotto" aria-label="8비트 로또 블록"></canvas>

    <div class="lab-controls">
      <button id="lotto-draw" type="button" class="btn-primary">블록 치기!</button>
      <button id="lotto-reset" type="button" class="btn-ghost">리셋</button>
      <button id="lotto-copy" type="button" class="btn-ghost" hidden>번호 복사</button>
      <button id="lotto-save" type="button" class="btn-ghost" hidden>이미지 저장</button>
    </div>
    <p id="lotto-status" class="lab-status">블록을 쳐서 번호를 뽑자!</p>
  </section>
</BaseLayout>

<style>
  .lab-card { border: 1px solid var(--border); border-radius: 16px; background: var(--surface); padding: 18px 18px 22px; }
  .lab-head { display: flex; align-items: center; justify-content: space-between; gap: 10px; margin-bottom: 12px; }
  .lab-head h2 { font-size: 1.05rem; font-weight: 700; font-family: var(--font-mono); letter-spacing: 0.02em; }
  .badge {
    font-size: 0.72rem; font-weight: 700; color: var(--accent);
    border: 1px solid color-mix(in srgb, var(--accent) 40%, var(--border));
    border-radius: 999px; padding: 1px 9px; margin-left: 6px; vertical-align: middle;
  }
  .lab-tag { font-size: 0.72rem; color: var(--muted); font-family: var(--font-mono); }
  #lotto {
    display: block; width: 100%; max-width: 512px; height: auto; aspect-ratio: 512 / 448;
    margin: 0 auto; image-rendering: pixelated; border-radius: 8px; cursor: pointer; touch-action: none;
    border: 3px solid #202020;
  }
  .lab-controls { display: flex; flex-wrap: wrap; justify-content: center; gap: 10px; margin-top: 14px; }
  .btn-primary {
    font: inherit; font-weight: 700; padding: 9px 24px; border: 0; border-radius: 10px;
    background: var(--accent); color: var(--accent-fg); cursor: pointer; transition: opacity .15s, transform .05s;
  }
  .btn-primary:hover { opacity: 0.9; }
  .btn-primary:active { transform: translateY(1px); }
  .btn-primary:disabled { opacity: 0.45; cursor: not-allowed; }
  .btn-ghost {
    font: inherit; font-weight: 600; padding: 9px 18px; border: 1px solid var(--border); border-radius: 10px;
    background: transparent; color: var(--muted); cursor: pointer; transition: border-color .15s, color .15s;
  }
  .btn-ghost:hover { border-color: var(--accent); color: var(--accent); }
  .lab-status { margin-top: 12px; text-align: center; font-size: 0.9rem; color: var(--muted); min-height: 1.3em; }
</style>

<script>
  const cv = document.getElementById("lotto");
  if (cv && cv.getContext) {
    const ctx = cv.getContext("2d");
    const W = 512, H = 448;
    const dpr = Math.min(window.devicePixelRatio || 1, 2);
    cv.width = W * dpr; cv.height = H * dpr; ctx.scale(dpr, dpr);
    ctx.imageSmoothingEnabled = false;

    // palette (NES-ish)
    const SKY = "#5c94fc", CLOUD = "#ffffff", CLOUDS = "#b8d8ff";
    const HILL = "#3ca63c", HILL_D = "#2e8020";
    const GND = "#e07414", GND_D = "#a83c08", GND_HI = "#f8a848", MORTAR = "#7c2c00";
    const BLK = "#f8b800", BLK_HI = "#ffd85c", BLK_D = "#b06800", INK = "#201008";
    const ballColor = (n) => n <= 10 ? "#fbc400" : n <= 20 ? "#5cb8f0" : n <= 30 ? "#ff6a6a" : n <= 40 ? "#b8bcc4" : "#8ed040";

    const BLOCK = { x: 228, y: 150, s: 56 };     // ? block
    const GROUND_Y = 356;
    const R = 17;                                 // result ball radius
    const SP = 62, mains = SP * 5, extra = 40, startX = (W - (mains + extra)) / 2;
    const slots = [];
    for (let i = 0; i < 6; i++) slots.push({ x: startX + SP * i, y: 400 });
    slots.push({ x: startX + mains + extra + SP, y: 400 });
    const plusX = (slots[5].x + slots[6].x) / 2;

    let balls = [], phase = "idle", bonk = 0, t = 0, blink = 0, lastResult = null;
    const status = document.getElementById("lotto-status");
    const drawBtn = document.getElementById("lotto-draw");
    const resetBtn = document.getElementById("lotto-reset");
    const copyBtn = document.getElementById("lotto-copy");
    const saveBtn = document.getElementById("lotto-save");

    // ---- pixel helpers ----
    const px = (x, y, w, h, c) => { ctx.fillStyle = c; ctx.fillRect(x | 0, y | 0, w | 0, h | 0); };
    function pixText(s, x, y, size, c, align) {
      ctx.font = "700 " + size + "px ui-monospace, 'SF Mono', Menlo, monospace";
      ctx.textAlign = align || "center"; ctx.textBaseline = "middle";
      ctx.fillStyle = INK; ctx.fillText(s, x + 2, y + 2);
      ctx.fillStyle = c; ctx.fillText(s, x, y);
    }
    function cloud(x, y) {
      px(x, y, 60, 16, CLOUD); px(x + 12, y - 10, 36, 14, CLOUD); px(x - 6, y + 6, 72, 12, CLOUD);
      px(x + 6, y + 16, 48, 4, CLOUDS);
    }
    function hill(x, y, w) {
      px(x, y, w, 40, HILL); px(x + 8, y - 12, w - 16, 14, HILL); px(x + w * 0.35, y - 22, w * 0.3, 12, HILL);
      px(x, y + 30, w, 10, HILL_D);
    }
    function drawScene() {
      px(0, 0, W, H, SKY);
      cloud(70, 70); cloud(360, 48); cloud(250, 110);
      hill(-20, GROUND_Y - 40, 150); hill(370, GROUND_Y - 30, 180);
      // ground
      px(0, GROUND_Y, W, H - GROUND_Y, GND);
      px(0, GROUND_Y, W, 6, GND_HI);
      px(0, GROUND_Y + 6, W, 4, GND_D);
      for (let y = GROUND_Y + 12; y < H; y += 22) {
        for (let x = 0; x < W; x += 32) { px(x, y, 32, 2, MORTAR); }
      }
      for (let x = 0; x < W; x += 32) { px(x, GROUND_Y + 12, 2, H, MORTAR); }
    }
    function drawBlock() {
      const oy = -Math.abs(Math.sin(bonk * Math.PI)) * 16;   // bonk hop
      const x = BLOCK.x, y = BLOCK.y + oy, s = BLOCK.s;
      px(x - 3, y - 3, s + 6, s + 6, INK);                   // outline
      px(x, y, s, s, phase === "idle" && blink % 60 < 30 ? BLK : BLK_HI);
      px(x, y, s, s, BLK); px(x, y, s, 6, BLK_HI); px(x, y + s - 8, s, 8, BLK_D);
      // rivets
      px(x + 4, y + 4, 6, 6, INK); px(x + s - 10, y + 4, 6, 6, INK);
      px(x + 4, y + s - 10, 6, 6, INK); px(x + s - 10, y + s - 10, 6, 6, INK);
      pixText("?", x + s / 2, y + s / 2 + 2, 34, "#fff");
    }
    function drawBall(b, x, y, r) {
      px(x - r, y - r, r * 2, r * 2, INK);                   // pixel square shadow (chunky)
      ctx.beginPath(); ctx.arc(x, y, r, 0, 7); ctx.fillStyle = b.color; ctx.fill();
      ctx.beginPath(); ctx.arc(x, y, r * 0.58, 0, 7); ctx.fillStyle = "#fff"; ctx.fill();
      pixText(String(b.n), x, y + 1, Math.round(r * 0.9), INK);
    }
    function render() {
      drawScene();
      // pop balls (arcing)
      for (const b of balls) {
        if (b.state === "pop") {
          const e = Math.min(b.t, 1), u = 1 - e;
          const bx = u * u * b.p0x + 2 * u * e * b.p1x + e * e * b.p2x;
          const by = u * u * b.p0y + 2 * u * e * b.p1y + e * e * b.p2y;
          drawBall(b, bx, by, R);
        }
      }
      drawBlock();
      // result tray slots
      for (const s of slots) { px(s.x - R - 3, s.y - R - 3, (R + 3) * 2, (R + 3) * 2, "#00000022"); px(s.x - R, s.y - R, R * 2, R * 2, "#ffffff33"); }
      pixText("+", plusX, slots[6].y, 22, "#fff");
      pixText("BONUS", slots[6].x, slots[6].y + R + 12, 10, "#fff");
      for (const b of balls) if (b.state === "placed") drawBall(b, b.p2x, b.p2y, R);
      // title
      pixText("★ LUCKY BLOCK ★", W / 2, 26, 18, "#fff");
    }

    function tick() {
      blink++;
      if (bonk > 0) bonk = Math.max(0, bonk - 0.12);
      for (const b of balls) if (b.state === "pop") { b.t += 0.05; if (b.t >= 1) b.state = "placed"; }
      render(); requestAnimationFrame(tick);
    }

    function showResultBtns(on) { copyBtn.hidden = !on; saveBtn.hidden = !on; }
    function resetGame() {
      balls = []; phase = "idle"; lastResult = null;
      showResultBtns(false); drawBtn.disabled = false;
      status.textContent = "블록을 쳐서 번호를 뽑자!";
    }
    function popOut(n, slot, delay) {
      setTimeout(() => {
        bonk = 1;
        const p0x = BLOCK.x + BLOCK.s / 2, p0y = BLOCK.y;
        balls.push({
          n, color: ballColor(n), state: "pop", t: 0,
          p0x, p0y, p1x: (p0x + slot.x) / 2, p1y: Math.min(p0y, slot.y) - 96,
          p2x: slot.x, p2y: slot.y,
        });
      }, delay);
    }
    function doDraw() {
      if (phase === "popping") return;
      resetGame(); phase = "popping"; drawBtn.disabled = true;
      status.textContent = "뽑는 중…";
      const pool = Array.from({ length: 45 }, (_, i) => i + 1);
      for (let i = pool.length - 1; i > 0; i--) { const j = (Math.random() * (i + 1)) | 0; [pool[i], pool[j]] = [pool[j], pool[i]]; }
      const six = pool.slice(0, 6).sort((a, b) => a - b), bonus = pool[6];
      six.forEach((n, i) => popOut(n, slots[i], i * 360));
      popOut(bonus, slots[6], 6 * 360);
      setTimeout(() => {
        phase = "done"; lastResult = { six, bonus };
        drawBtn.disabled = false; showResultBtns(true);
        status.textContent = "당첨 번호  " + six.join(", ") + "   +   보너스 " + bonus;
      }, 6 * 360 + 900);
    }

    cv.addEventListener("click", (e) => {
      const rect = cv.getBoundingClientRect();
      const x = (e.clientX - rect.left) / rect.width * W, y = (e.clientY - rect.top) / rect.height * H;
      if (x > BLOCK.x - 10 && x < BLOCK.x + BLOCK.s + 10 && y > BLOCK.y - 26 && y < BLOCK.y + BLOCK.s + 10) doDraw();
    });
    drawBtn.addEventListener("click", doDraw);
    resetBtn.addEventListener("click", resetGame);
    copyBtn.addEventListener("click", async () => {
      if (!lastResult) return;
      try { await navigator.clipboard.writeText(lastResult.six.join(", ") + "  +  보너스 " + lastResult.bonus);
        copyBtn.textContent = "복사됨!"; setTimeout(() => (copyBtn.textContent = "번호 복사"), 1200); } catch (e) {}
    });
    saveBtn.addEventListener("click", () => {
      const a = document.createElement("a");
      a.download = "lotto-" + (lastResult ? lastResult.six.join("-") : "draw") + ".png";
      a.href = cv.toDataURL("image/png"); a.click();
    });

    tick();
  }
</script>
