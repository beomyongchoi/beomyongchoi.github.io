---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { SITE } from "../../consts";

const groups = [
  {
    label: "📐 행렬로 생각하기 (기초)",
    desc: "LLM 밑바닥의 선형대수. 왜 벡터로 표현하고 왜 행렬곱인지 — 트랜스포머 시리즈의 prequel.",
    toys: [
      { href: "/playground/vectors/", toy: "vectors", title: "벡터와 내적", tag: "0편 · 왜 벡터", desc: "두 벡터를 드래그하면 내적·각도·투영이 실시간으로. 내적이 '닮음의 점수'인 걸 손으로." },
      { href: "/playground/matmul/", toy: "matmul", title: "행렬곱 = 내적의 묶음", tag: "1편 · 행렬", desc: "결과 셀을 클릭하면 A의 행·B의 열이 켜지고 그 셀이 둘의 내적으로 채워지는 행렬곱." },
    ],
  },
  {
    label: "🧠 트랜스포머 시리즈",
    desc: "어텐션부터 GPT까지, LLM이 어떻게 작동하는지 글 + 인터랙티브로 하나씩.",
    toys: [
      { href: "/playground/embeddings/", toy: "embeddings", title: "토큰화·임베딩", tag: "0편 · 온램프", desc: "단어가 서브워드로 쪼개지고, 임베딩 공간에서 뜻이 좌표가 되는 것." },
      { href: "/playground/transformer/", toy: "transformer", title: "Attention 시각화", tag: "1편 · 어텐션", desc: "트랜스포머 self-attention을 눈으로. 단어가 어디에 집중하는지." },
      { href: "/playground/transformer-block/", toy: "transformerblock", title: "트랜스포머 블록 시각화", tag: "2편 · 블록", desc: "토큰 벡터가 어텐션·잔차·FFN 블록을 지나며 갱신되는 잔차 스트림." },
      { href: "/playground/bert/", toy: "bert", title: "BERT 빈칸 맞히기", tag: "3편 · 인코더", desc: "양방향으로 [MASK] 자리를 맞히기. GPT의 왼쪽만-보기와 비교." },
      { href: "/playground/gpt/", toy: "gpt", title: "GPT 자기회귀 생성", tag: "4편 · 디코더", desc: "causal 마스크로 왼쪽만 보고 토큰을 하나씩 생성. temperature·마스크 삼각형." },
    ],
  },
  {
    label: "🔎 그 외 AI 실험",
    desc: "",
    toys: [
      { href: "/playground/fanout/", toy: "fanout", title: "Query Fan-out 시각화", tag: "AI · 검색", desc: "질문이 하위 쿼리로 쪼개져, 구체적인 문단만 검색되는 과정." },
    ],
  },
  {
    label: "🎮 그냥 재미",
    desc: "",
    toys: [
      { href: "/playground/lotto/", toy: "lotto", title: "LUCKY BLOCK", tag: "8-bit · Canvas", desc: "마리오를 키보드로 몰아 블록을 까는 8비트 아케이드 로또 추첨기." },
    ],
  },
];
---

<BaseLayout
  title={`실험실 — ${SITE.authorKo}`}
  description="블로그 곁에서 굴려보는 소소한 사이드 프로젝트들. Canvas·JS로 직접 만든 장난감과 시각화."
  locale="ko"
  path="/playground/"
>
  <header class="mb-10">
    <h1 class="text-3xl font-bold tracking-tight sm:text-4xl">실험실</h1>
    <p class="mt-3 text-muted">블로그 곁에서 굴려보는 소소한 것들. Canvas·JS로 직접 만든 장난감과 시각화.</p>
  </header>

  {
    groups.map((g) => (
      <section class="pg-group">
        <div class="pg-grouphead">
          <h2>{g.label}</h2>
          {g.desc && <p>{g.desc}</p>}
        </div>
        <div class="pg-grid">
          {g.toys.map((t) => (
            <a class="pg-card" href={t.href}>
              <div class="pg-thumb-wrap">
                <canvas class="pg-thumb" data-toy={t.toy}></canvas>
                <span class="pg-play">▶ PLAY</span>
              </div>
              <div class="pg-meta">
                <div class="pg-title-row">
                  <h3>{t.title}</h3>
                  <span class="pg-tag">{t.tag}</span>
                </div>
                <p>{t.desc}</p>
              </div>
            </a>
          ))}
        </div>
      </section>
    ))
  }
</BaseLayout>

<style>
  .pg-grid { display: grid; gap: 18px; grid-template-columns: 1fr; }
  @media (min-width: 640px) { .pg-grid { grid-template-columns: 1fr 1fr; } }
  .pg-card {
    display: block; border: 1px solid var(--border); border-radius: 14px; overflow: hidden; background: var(--surface);
    text-decoration: none; color: inherit; transition: transform .12s, box-shadow .12s, border-color .12s;
  }
  .pg-card:hover { transform: translateY(-3px); border-color: color-mix(in srgb, var(--accent) 45%, var(--border)); box-shadow: 0 10px 24px rgba(0,0,0,0.1); }
  .pg-thumb-wrap { position: relative; border-bottom: 1px solid var(--border); background: #5c94fc; }
  .pg-thumb { display: block; width: 100%; height: auto; aspect-ratio: 2 / 1; }
  .pg-thumb[data-toy="lotto"] { image-rendering: pixelated; }
  .pg-play {
    position: absolute; right: 10px; bottom: 10px; font-family: var(--font-mono); font-size: 0.68rem; font-weight: 700;
    color: #fff; background: rgba(0,0,0,0.5); padding: 3px 9px; border-radius: 999px; opacity: 0; transition: opacity .15s;
  }
  .pg-card:hover .pg-play { opacity: 1; }
  .pg-meta { padding: 14px 16px 16px; }
  .pg-title-row { display: flex; align-items: baseline; justify-content: space-between; gap: 8px; }
  .pg-meta h3 { font-size: 1.05rem; font-weight: 700; }
  .pg-tag { font-size: 0.68rem; color: var(--muted); font-family: var(--font-mono); white-space: nowrap; }
  .pg-meta p { margin-top: 6px; font-size: 0.86rem; color: var(--muted); line-height: 1.5; }

  .pg-group { margin-bottom: 34px; }
  .pg-grouphead { margin-bottom: 14px; padding-bottom: 8px; border-bottom: 1px solid var(--border); }
  .pg-grouphead h2 { font-size: 1.15rem; font-weight: 700; }
  .pg-grouphead p { margin-top: 3px; font-size: 0.85rem; color: var(--muted); }
</style>

<script>
  const thumbs = [...document.querySelectorAll(".pg-thumb")].map((cv) => {
    const toy = cv.dataset.toy;
    const W = toy === "lotto" ? 128 : 240, H = toy === "lotto" ? 64 : 120;  // both 2:1, no stretch
    cv.width = W; cv.height = H;
    const ctx = cv.getContext("2d"); ctx.imageSmoothingEnabled = toy !== "lotto";
    return { cv, ctx, toy, W, H };
  });

  function lotto(ctx, W, H, f) {
    ctx.fillStyle = "#5c94fc"; ctx.fillRect(0, 0, W, H);
    ctx.fillStyle = "#fff"; ctx.fillRect(18, 12, 14, 4); ctx.fillRect(92, 16, 14, 4);
    ctx.fillStyle = "#e08020"; ctx.fillRect(0, H - 14, W, 14);
    ctx.fillStyle = "#7a2c00"; for (let x = 0; x < W; x += 12) ctx.fillRect(x, H - 14, 1, 14);
    const cyc = f % 120, bonk = cyc < 12 ? Math.sin((cyc / 12) * Math.PI) * 5 : 0;
    const bxp = W / 2 - 8, byp = 24 - bonk;
    ctx.fillStyle = "#201008"; ctx.fillRect(bxp - 1, byp - 1, 18, 18);
    ctx.fillStyle = cyc < 12 ? "#b06818" : "#f8b020"; ctx.fillRect(bxp, byp, 16, 16);
    ctx.fillStyle = "#a86008"; ctx.fillRect(bxp, byp + 13, 16, 3);
    if (cyc >= 12) { ctx.fillStyle = "#fff"; ctx.font = "700 11px monospace"; ctx.textAlign = "center"; ctx.textBaseline = "middle"; ctx.fillText("?", bxp + 8, byp + 8); }
    if (cyc < 40) {
      const e = cyc / 40, cy = byp - Math.sin(e * Math.PI) * 26, cx = W / 2 + e * 26;
      ctx.fillStyle = "#fcd800"; ctx.beginPath(); ctx.arc(cx, cy, 6, 0, 7); ctx.fill();
      ctx.fillStyle = "#a86008"; ctx.font = "700 8px monospace"; ctx.textAlign = "center"; ctx.textBaseline = "middle"; ctx.fillText("7", cx, cy);
    }
  }
  // BertViz-style: two columns of tokens, curved lines between them, one bold
  // connection (query→key) pulsing and cycling — mirrors the real toy.
  function transformer(ctx, W, H, f) {
    const cs = getComputedStyle(document.documentElement);
    ctx.fillStyle = cs.getPropertyValue("--surface").trim() || "#f2f3f5"; ctx.fillRect(0, 0, W, H);
    const acc = cs.getPropertyValue("--accent").trim() || "#2b4a7e";
    const n = 5, lx = 32, rx = W - 32, mx = W / 2;
    const ys = Array.from({ length: n }, (_, i) => 18 + i * (H - 36) / (n - 1));
    const cols = ["#9696a0", "#3a82f6", "#22a06b", "#9696a0", "#9a5adc"];
    const q = Math.floor(f / 70) % n, tgt = (q + 2) % n, phase = (f % 70) / 70;
    const curve = (y1, y2, a, w) => {
      ctx.strokeStyle = acc; ctx.globalAlpha = a; ctx.lineWidth = w;
      ctx.beginPath(); ctx.moveTo(lx, y1); ctx.bezierCurveTo(mx, y1, mx, y2, rx, y2); ctx.stroke();
    };
    for (let i = 0; i < n; i++) curve(ys[i], ys[i], 0.06, 1);           // faint backdrop
    for (let j = 0; j < n; j++) if (j !== tgt) curve(ys[q], ys[j], 0.1, 1.2); // active token's spread
    curve(ys[q], ys[tgt], 0.3 + 0.35 * Math.sin(phase * Math.PI), 3.2);  // bold, pulsing
    ctx.globalAlpha = 1;
    for (let i = 0; i < n; i++) for (const [x, on] of [[lx, i === q], [rx, i === tgt]]) {
      ctx.fillStyle = on ? acc : cols[i]; ctx.beginPath(); ctx.arc(x, ys[i], on ? 5 : 3.5, 0, 7); ctx.fill();
      if (on) { ctx.strokeStyle = "#fff"; ctx.lineWidth = 1.5; ctx.stroke(); }
    }
  }

  function fanout(ctx, W, H, f) {
    const cs = getComputedStyle(document.documentElement);
    ctx.fillStyle = cs.getPropertyValue("--surface").trim() || "#f2f3f5"; ctx.fillRect(0, 0, W, H);
    const acc = cs.getPropertyValue("--accent").trim() || "#2b4a7e";
    const qx = 24, qy = H / 2;
    const subs = [{ x: 104, y: 30 }, { x: 104, y: 60 }, { x: 104, y: 90 }];
    const pass = [{ y: 20, ret: true }, { y: 48, ret: true }, { y: 76, ret: false }, { y: 104, ret: true }];
    const px = 166, pw = 54, pulse = 0.5 + 0.5 * Math.sin(f * 0.05);
    ctx.strokeStyle = acc; ctx.lineCap = "round";
    subs.forEach((s) => { ctx.globalAlpha = 0.3 + 0.22 * pulse; ctx.lineWidth = 1.3; ctx.beginPath(); ctx.moveTo(qx + 6, qy); ctx.bezierCurveTo((qx + s.x) / 2, qy, (qx + s.x) / 2, s.y, s.x - 4, s.y); ctx.stroke(); });
    [[0, 0], [1, 1], [2, 3], [1, 3]].forEach(([si, pj]) => { const s = subs[si], p = pass[pj]; if (!p.ret) return; ctx.globalAlpha = 0.28 + 0.42 * pulse; ctx.lineWidth = 1.6; ctx.beginPath(); ctx.moveTo(s.x + 4, s.y); ctx.bezierCurveTo((s.x + px) / 2, s.y, (s.x + px) / 2, p.y + 5, px, p.y + 5); ctx.stroke(); });
    ctx.globalAlpha = 1;
    ctx.fillStyle = acc; ctx.beginPath(); ctx.arc(qx, qy, 7, 0, 7); ctx.fill(); ctx.strokeStyle = "#fff"; ctx.lineWidth = 1.5; ctx.stroke();
    subs.forEach((s) => { ctx.fillStyle = acc; ctx.beginPath(); ctx.arc(s.x, s.y, 4.5, 0, 7); ctx.fill(); });
    pass.forEach((p) => { ctx.fillStyle = p.ret ? acc : "#c9ccd2"; ctx.beginPath(); ctx.roundRect(px, p.y, pw, 10, 3); ctx.fill(); });
  }

  function transformerblock(ctx, W, H, f) {
    const cs = getComputedStyle(document.documentElement);
    ctx.fillStyle = cs.getPropertyValue("--surface").trim() || "#f2f3f5"; ctx.fillRect(0, 0, W, H);
    const acc = cs.getPropertyValue("--accent").trim() || "#2b4a7e";
    const sx = 22, rows = 4, cells = 8, cw = (W - 74) / cells, x0 = 58;
    ctx.strokeStyle = acc; ctx.lineWidth = 3; ctx.beginPath(); ctx.moveTo(sx, 16); ctx.lineTo(sx, H - 16); ctx.stroke();
    for (let r = 0; r < rows; r++) {
      const y = 18 + r * (H - 36) / (rows - 1);
      ctx.fillStyle = acc; ctx.beginPath(); ctx.arc(sx, y, r === 0 || r === rows - 1 ? 5 : 4, 0, 7); ctx.fill();
      for (let c = 0; c < cells; c++) {
        const v = 0.15 + 0.7 * Math.abs(Math.sin(c * 0.8 + r * 1.3 + f * 0.03));
        ctx.globalAlpha = 0.12; ctx.fillStyle = acc; ctx.fillRect(x0 + c * cw, y - 7, cw - 2, 14);
        ctx.globalAlpha = v; ctx.fillRect(x0 + c * cw, y - 7, cw - 2, 14);
      }
    }
    ctx.globalAlpha = 1;
  }

  function bert(ctx, W, H, f) {
    const cs = getComputedStyle(document.documentElement);
    ctx.fillStyle = cs.getPropertyValue("--surface").trim() || "#f2f3f5"; ctx.fillRect(0, 0, W, H);
    const acc = cs.getPropertyValue("--accent").trim() || "#2b4a7e";
    const n = 6, mid = 2, y = H * 0.66, xs = Array.from({ length: n }, (_, i) => 26 + i * (W - 52) / (n - 1));
    const mx = xs[mid], pulse = 0.5 + 0.5 * Math.sin(f * 0.05);
    ctx.strokeStyle = acc; ctx.lineCap = "round";
    xs.forEach((x, i) => { if (i === mid) return; ctx.globalAlpha = 0.25 + 0.4 * pulse; ctx.lineWidth = 1.6;
      ctx.beginPath(); ctx.moveTo(x, y - 4); ctx.quadraticCurveTo((x + mx) / 2, y - 30 - Math.abs(x - mx) * 0.14, mx, y - 12); ctx.stroke(); });
    ctx.globalAlpha = 1;
    xs.forEach((x, i) => {
      if (i === mid) { ctx.fillStyle = acc; ctx.beginPath(); ctx.roundRect(x - 13, y - 9, 26, 18, 4); ctx.fill();
        ctx.fillStyle = "#fff"; ctx.font = "700 9px ui-monospace, monospace"; ctx.textAlign = "center"; ctx.textBaseline = "middle"; ctx.fillText("MASK", x, y); }
      else { ctx.fillStyle = "#9aa0aa"; ctx.beginPath(); ctx.arc(x, y, 4.5, 0, 7); ctx.fill(); }
    });
  }

  function gpt(ctx, W, H, f) {
    const cs = getComputedStyle(document.documentElement);
    ctx.fillStyle = cs.getPropertyValue("--surface").trim() || "#f2f3f5"; ctx.fillRect(0, 0, W, H);
    const acc = cs.getPropertyValue("--accent").trim() || "#2b4a7e";
    const n = 6, cell = 13, gap = 3, gw = n * cell + (n - 1) * gap, x0 = (W - gw) / 2, y0 = (H - gw) / 2;
    const front = Math.floor(f / 22) % (n + 3);   // autoregressive fill front (grows, then resets)
    for (let i = 0; i < n; i++) for (let j = 0; j < n; j++) {
      const x = x0 + j * (cell + gap), y = y0 + i * (cell + gap);
      if (j <= i) { ctx.globalAlpha = i <= front ? (i === front ? 0.55 + 0.45 * Math.abs(Math.sin(f * 0.1)) : 1) : 0.14; ctx.fillStyle = acc; }
      else { ctx.globalAlpha = 1; ctx.fillStyle = "#d7dae0"; }
      ctx.beginPath(); ctx.roundRect(x, y, cell, cell, 3); ctx.fill();
    }
    ctx.globalAlpha = 1;
  }

  function embeddings(ctx, W, H, f) {
    const cs = getComputedStyle(document.documentElement);
    ctx.fillStyle = cs.getPropertyValue("--surface").trim() || "#f2f3f5"; ctx.fillRect(0, 0, W, H);
    const acc = cs.getPropertyValue("--accent").trim() || "#2b4a7e";
    const pts = [
      [58, 44, acc], [92, 42, acc], [58, 78, acc], [92, 76, acc],   // royalty square
      [188, 34, "#22a06b"], [206, 30, "#22a06b"], [198, 48, "#22a06b"],   // animals
      [150, 96, "#e0842a"], [168, 90, "#e0842a"],   // food
    ];
    const pulse = 0.5 + 0.5 * Math.sin(f * 0.05);
    ctx.strokeStyle = acc; ctx.lineWidth = 1.6; ctx.globalAlpha = 0.35 + 0.35 * pulse;   // parallel analogy arrows
    [[0, 1], [2, 3]].forEach(([a, b]) => { ctx.beginPath(); ctx.moveTo(pts[a][0], pts[a][1]); ctx.lineTo(pts[b][0], pts[b][1]); ctx.stroke();
      const ang = Math.atan2(pts[b][1] - pts[a][1], pts[b][0] - pts[a][0]); const hx = pts[b][0], hy = pts[b][1];
      ctx.beginPath(); ctx.moveTo(hx, hy); ctx.lineTo(hx - 5 * Math.cos(ang - 0.5), hy - 5 * Math.sin(ang - 0.5)); ctx.moveTo(hx, hy); ctx.lineTo(hx - 5 * Math.cos(ang + 0.5), hy - 5 * Math.sin(ang + 0.5)); ctx.stroke(); });
    ctx.globalAlpha = 1;
    pts.forEach(([x, y, c]) => { ctx.fillStyle = c; ctx.beginPath(); ctx.arc(x, y, 4.5, 0, 7); ctx.fill(); });
  }

  // two vectors from a centered origin; the angle between them sweeps so the
  // "aligned → wide → opposed" story reads at a glance, mirroring the toy.
  function vectors(ctx, W, H, f) {
    const cs = getComputedStyle(document.documentElement);
    ctx.fillStyle = cs.getPropertyValue("--surface").trim() || "#f2f3f5"; ctx.fillRect(0, 0, W, H);
    const acc = cs.getPropertyValue("--accent").trim() || "#2b4a7e", grn = "#22a06b";
    const border = cs.getPropertyValue("--border").trim() || "#e5e6e9";
    const ox = W / 2, oy = H / 2, L = 40;
    ctx.strokeStyle = border; ctx.lineWidth = 1;
    ctx.beginPath(); ctx.moveTo(0, oy); ctx.lineTo(W, oy); ctx.moveTo(ox, 0); ctx.lineTo(ox, H); ctx.stroke();
    const aAng = -0.5, bAng = -0.5 - (0.75 + 0.75 * Math.sin(f * 0.03)) * Math.PI; // b sweeps around
    const arw = (ang, col) => {
      const x = ox + Math.cos(ang) * L, y = oy + Math.sin(ang) * L;
      ctx.strokeStyle = col; ctx.fillStyle = col; ctx.lineWidth = 3;
      ctx.beginPath(); ctx.moveTo(ox, oy); ctx.lineTo(x, y); ctx.stroke();
      ctx.beginPath(); ctx.arc(x, y, 3.5, 0, 7); ctx.fill();
    };
    // shade the angle wedge, tinted by sign of cos(angle between)
    const between = bAng - aAng, c = Math.cos(between);
    ctx.fillStyle = c > 0.05 ? grn : c < -0.05 ? "#d8503a" : "#9aa0aa"; ctx.globalAlpha = 0.16;
    ctx.beginPath(); ctx.moveTo(ox, oy); ctx.arc(ox, oy, 22, aAng, bAng, bAng < aAng); ctx.closePath(); ctx.fill();
    ctx.globalAlpha = 1;
    arw(aAng, acc); arw(bAng, grn);
    ctx.fillStyle = acc; ctx.beginPath(); ctx.arc(ox, oy, 3, 0, 7); ctx.fill();
  }

  // miniature A·B=C: the selected output cell cycles, lighting its A-row and
  // B-column, so "each cell = a row·col dot product" reads at a glance.
  function matmul(ctx, W, H, f) {
    const cs = getComputedStyle(document.documentElement);
    ctx.fillStyle = cs.getPropertyValue("--surface").trim() || "#f2f3f5"; ctx.fillRect(0, 0, W, H);
    const acc = cs.getPropertyValue("--accent").trim() || "#2b4a7e", grn = "#22a06b";
    const border = cs.getPropertyValue("--border").trim() || "#e5e6e9";
    const K = 3, N = 2, M = 2, step = 17, cell = 14, gap = 7;
    const Clx = K * step + gap, Cly = K * step + gap;
    const clusterW = Clx + (N - 1) * step + cell, clusterH = Cly + (M - 1) * step + cell;
    const ox = (W - clusterW) / 2, oy = (H - clusterH) / 2;
    const sel = Math.floor(f / 45) % (M * N), si = Math.floor(sel / N), sj = sel % N;
    const box = (x, y, on, col, pulse) => {
      ctx.fillStyle = on ? col : "#ffffff"; ctx.globalAlpha = on ? (pulse ? 0.5 + 0.4 * Math.abs(Math.sin(f * 0.12)) : 0.9) : 1;
      ctx.fillRect(ox + x, oy + y, cell, cell);
      ctx.globalAlpha = 1; ctx.strokeStyle = on ? col : border; ctx.lineWidth = on ? 1.5 : 1;
      ctx.strokeRect(ox + x, oy + y, cell, cell);
    };
    // B (top-right), highlight column sj
    for (let r = 0; r < K; r++) for (let j = 0; j < N; j++) box(Clx + j * step, r * step, j === sj, grn, false);
    // A (bottom-left), highlight row si
    for (let i = 0; i < M; i++) for (let k = 0; k < K; k++) box(k * step, Cly + i * step, i === si, acc, false);
    // C (bottom-right), highlight the selected cell (pulsing)
    for (let i = 0; i < M; i++) for (let j = 0; j < N; j++) box(Clx + j * step, Cly + i * step, i === si && j === sj, acc, true);
  }

  const FN = { vectors, matmul, lotto, transformer, fanout, transformerblock, bert, gpt, embeddings };
  let f = 0;
  function loop() {
    f++;
    for (const t of thumbs) FN[t.toy](t.ctx, t.W, t.H, f);
    requestAnimationFrame(loop);
  }
  loop();
</script>
