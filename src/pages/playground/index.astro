---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { SITE } from "../../consts";
---

<BaseLayout
  title={`실험실 — ${SITE.authorKo}`}
  description="블로그 곁에서 굴려보는 소소한 사이드 프로젝트들. 첫 번째는 Canvas로 직접 물리를 구현한 가챠 로또 추첨기."
  locale="ko"
  path="/playground/"
>
  <header class="mb-10">
    <h1 class="text-3xl font-bold tracking-tight sm:text-4xl">실험실</h1>
    <p class="mt-3 text-muted">블로그 곁에서 굴려보는 소소한 것들. Canvas·JS로 직접 만든 장난감.</p>
  </header>

  <section class="lab-card">
    <div class="lab-head">
      <h2>가챠 로또 추첨기 <span class="badge">6 / 45</span></h2>
      <span class="lab-tag">Canvas 2D · 직접 물리</span>
    </div>

    <canvas id="lotto" aria-label="가챠 로또 추첨기"></canvas>

    <div class="lab-controls">
      <button id="lotto-draw" type="button" class="btn-primary">추첨 (손잡이 돌리기)</button>
      <button id="lotto-reset" type="button" class="btn-ghost">리셋</button>
      <button id="lotto-copy" type="button" class="btn-ghost" hidden>번호 복사</button>
      <button id="lotto-save" type="button" class="btn-ghost" hidden>이미지 저장</button>
    </div>
    <p id="lotto-status" class="lab-status">공이 통 바닥에 가라앉아 있어요. 손잡이를 돌려(눌러) 뽑아보세요.</p>
  </section>
</BaseLayout>

<style>
  .lab-card { border: 1px solid var(--border); border-radius: 16px; background: var(--surface); padding: 18px 18px 22px; }
  .lab-head { display: flex; align-items: center; justify-content: space-between; gap: 10px; margin-bottom: 12px; }
  .lab-head h2 { font-size: 1.15rem; font-weight: 700; }
  .badge {
    font-size: 0.72rem; font-weight: 700; color: var(--accent);
    border: 1px solid color-mix(in srgb, var(--accent) 40%, var(--border));
    border-radius: 999px; padding: 1px 9px; margin-left: 6px; vertical-align: middle;
  }
  .lab-tag { font-size: 0.72rem; color: var(--muted); font-family: var(--font-mono); }
  #lotto {
    display: block; width: 100%; max-width: 440px; height: auto; aspect-ratio: 460 / 820;
    margin: 0 auto; touch-action: none; cursor: pointer;
  }
  .lab-controls { display: flex; flex-wrap: wrap; justify-content: center; gap: 10px; margin-top: 14px; }
  .btn-primary {
    font: inherit; font-weight: 600; padding: 9px 24px; border: 0; border-radius: 10px;
    background: var(--accent); color: var(--accent-fg); cursor: pointer; transition: opacity .15s, transform .05s;
  }
  .btn-primary:hover { opacity: 0.9; }
  .btn-primary:active { transform: translateY(1px); }
  .btn-primary:disabled { opacity: 0.45; cursor: not-allowed; }
  .btn-ghost {
    font: inherit; font-weight: 600; padding: 9px 18px; border: 1px solid var(--border); border-radius: 10px;
    background: transparent; color: var(--muted); cursor: pointer; transition: border-color .15s, color .15s;
  }
  .btn-ghost:hover { border-color: var(--accent); color: var(--accent); }
  .lab-status { margin-top: 12px; text-align: center; font-size: 0.9rem; color: var(--muted); min-height: 1.3em; }
</style>

<script>
  const cv = document.getElementById("lotto");
  if (cv && cv.getContext) {
    const ctx = cv.getContext("2d");
    const W = 460, H = 820;
    const dpr = Math.min(window.devicePixelRatio || 1, 2);
    cv.width = W * dpr; cv.height = H * dpr; ctx.scale(dpr, dpr);
    const dark = matchMedia("(prefers-color-scheme: dark)").matches;

    // ---- geometry ----
    const DR = { x: 230, y: 190, r: 146 };          // clear drum
    const KNOB = { x: 150, y: 452, r: 44 };
    const DOOR = { x: 230, y: 528 };                // dispense chute
    const R0 = 13, R1 = 20, TRAY_Y = 752, SLOT_R = 20;
    const LAYERS = 4, LSCALE = [0.82, 0.92, 1.0, 1.1], LALPHA = [0.9, 0.95, 1.0, 1.0];

    const ballColor = (n) =>
      n <= 10 ? "#fbc400" : n <= 20 ? "#69c8f2" : n <= 30 ? "#ff7272" : n <= 40 ? "#9aa0a6" : "#b0d840";

    const SP = 52, mains = SP * 5, extra = 64, startX = (W - (mains + extra)) / 2;
    const slots = [];
    for (let i = 0; i < 6; i++) slots.push({ x: startX + SP * i, y: TRAY_Y });
    slots.push({ x: startX + mains + extra, y: TRAY_Y });
    const plusX = (slots[5].x + slots[6].x) / 2;

    let balls = [], phase = "idle", blow = 0, lastResult = null, knobSpin = 0;
    const status = document.getElementById("lotto-status");
    const drawBtn = document.getElementById("lotto-draw");
    const resetBtn = document.getElementById("lotto-reset");
    const copyBtn = document.getElementById("lotto-copy");
    const saveBtn = document.getElementById("lotto-save");

    function seedTank() {
      balls = [];
      for (let n = 1; n <= 45; n++) {
        const a = Math.random() * Math.PI * 2, rr = Math.random() * (DR.r - R0 - 8);
        balls.push({
          n, x: DR.x + Math.cos(a) * rr, y: DR.y + Math.sin(a) * rr * 0.5 + DR.r * 0.35,
          vx: (Math.random() - 0.5) * 3, vy: Math.random() * 2,
          layer: (Math.random() * LAYERS) | 0, color: ballColor(n), state: "tank",
        });
      }
    }

    function physics() {
      for (const b of balls) {
        if (b.state === "flying") {
          b.f += 1;
          if (b.f <= 12) { const e = (b.f / 12) ** 2; b.x = b.sx + (DOOR.x - b.sx) * e; b.y = b.sy + (DOOR.y - b.sy) * e; }
          else {
            const e = Math.min((b.f - 12) / (b.dur - 12), 1), ee = 1 - Math.pow(1 - e, 3);
            b.x = DOOR.x + (b.tx - DOOR.x) * ee; b.y = DOOR.y + (b.ty - DOOR.y) * ee + Math.sin(e * Math.PI) * 22;
            b.r = R0 + (R1 - R0) * ee;
            if (e >= 1) { b.state = "placed"; b.x = b.tx; b.y = b.ty; b.r = R1; }
          }
          continue;
        }
        if (b.state !== "tank") continue;
        b.vy += 0.22; b.vy -= 0.4 * blow;
        b.vx += (Math.random() - 0.5) * 1.9 * blow; b.vy += (Math.random() - 0.5) * 1.9 * blow;
        b.vx *= 0.986; b.vy *= 0.986;
        const sp = Math.hypot(b.vx, b.vy), MAX = 12; if (sp > MAX) { b.vx *= MAX / sp; b.vy *= MAX / sp; }
        b.x += b.vx; b.y += b.vy;
        const dx = b.x - DR.x, dy = b.y - DR.y, d = Math.hypot(dx, dy) || 1, lim = DR.r - R0 - 3;
        if (d > lim) {
          const nx = dx / d, ny = dy / d; b.x = DR.x + nx * lim; b.y = DR.y + ny * lim;
          const vn = b.vx * nx + b.vy * ny; b.vx -= 1.7 * vn * nx; b.vy -= 1.7 * vn * ny;
        }
      }
      for (let L = 0; L < LAYERS; L++) {
        const t = balls.filter((b) => b.state === "tank" && b.layer === L);
        for (let i = 0; i < t.length; i++) for (let j = i + 1; j < t.length; j++) {
          const a = t[i], c = t[j], dx = c.x - a.x, dy = c.y - a.y, d = Math.hypot(dx, dy) || 1, min = R0 * 2;
          if (d < min) {
            const nx = dx / d, ny = dy / d, ov = (min - d) / 2;
            a.x -= nx * ov; a.y -= ny * ov; c.x += nx * ov; c.y += ny * ov;
            const va = a.vx * nx + a.vy * ny, vb = c.vx * nx + c.vy * ny, s = va - vb;
            a.vx -= s * nx; a.vy -= s * ny; c.vx += s * nx; c.vy += s * ny;
          }
        }
      }
      if (knobSpin > 0) knobSpin -= 0.15;
    }

    // ---- drawing helpers ----
    function rr(x, y, w, h, r) {
      ctx.beginPath();
      ctx.moveTo(x + r, y); ctx.arcTo(x + w, y, x + w, y + h, r); ctx.arcTo(x + w, y + h, x, y + h, r);
      ctx.arcTo(x, y + h, x, y, r); ctx.arcTo(x, y, x + w, y, r); ctx.closePath();
    }
    const PL = "#f3f4f7", PL_HI = "#ffffff", PL_SH = "#d6d9e0", CHR0 = "#f2f4f8", CHR1 = "#c3c8d2", CHR2 = "#8f96a3";

    function drawMachine() {
      // wheels
      ctx.fillStyle = "#3a3d44";
      for (const wx of [95, 185, 275, 365]) { ctx.beginPath(); ctx.ellipse(wx, 700, 15, 11, 0, 0, 7); ctx.fill(); }
      // base
      ctx.save(); ctx.shadowColor = "rgba(0,0,0,0.18)"; ctx.shadowBlur = 18; ctx.shadowOffsetY = 8;
      rr(28, 598, 404, 96, 26); ctx.fillStyle = PL; ctx.fill(); ctx.restore();
      // body tower
      rr(72, 300, 316, 306, 34); ctx.fillStyle = PL; ctx.fill();
      const bg = ctx.createLinearGradient(72, 300, 388, 300);
      bg.addColorStop(0, "rgba(255,255,255,0.6)"); bg.addColorStop(0.5, "rgba(255,255,255,0)"); bg.addColorStop(1, "rgba(0,0,0,0.06)");
      rr(72, 300, 316, 306, 34); ctx.fillStyle = bg; ctx.fill();
      // knob (chrome, turnable)
      ctx.save(); ctx.translate(KNOB.x, KNOB.y); ctx.rotate(knobSpin);
      const kg = ctx.createRadialGradient(-14, -16, 4, 0, 0, KNOB.r);
      kg.addColorStop(0, CHR0); kg.addColorStop(0.55, CHR1); kg.addColorStop(1, CHR2);
      ctx.beginPath(); ctx.arc(0, 0, KNOB.r, 0, 7); ctx.fillStyle = kg; ctx.fill();
      ctx.lineWidth = 3; ctx.strokeStyle = "rgba(0,0,0,0.15)"; ctx.stroke();
      ctx.fillStyle = "#6b7280"; // turn slot
      rr(-6, -KNOB.r + 8, 12, KNOB.r * 2 - 16, 6); ctx.fill();
      ctx.restore();
      ctx.fillStyle = "#9aa0aa"; ctx.font = "600 11px ui-sans-serif, system-ui, sans-serif";
      ctx.textAlign = "center"; ctx.textBaseline = "middle"; ctx.fillText("돌려서 뽑기", KNOB.x, KNOB.y + KNOB.r + 14);
      // coin slot + label
      rr(292, 430, 44, 66, 10); ctx.fillStyle = "#e7e9ee"; ctx.fill(); ctx.strokeStyle = "#c9cdd6"; ctx.lineWidth = 2; ctx.stroke();
      ctx.fillStyle = "#3a3d44"; rr(310, 438, 8, 26, 3); ctx.fill();
      ctx.fillStyle = "#8b909b"; ctx.font = "700 12px ui-sans-serif, system-ui, sans-serif"; ctx.fillText("500", 314, 480);
      // dispense door
      rr(202, 506, 56, 46, 8); ctx.fillStyle = "#2a2d33"; ctx.fill();
      ctx.fillStyle = "rgba(255,255,255,0.10)"; rr(206, 510, 48, 18, 5); ctx.fill();
      ctx.fillStyle = "#9aa0aa"; ctx.font = "10px ui-sans-serif, system-ui, sans-serif"; ctx.fillText("PUSH", 230, 544);
      // neck
      rr(150, 280, 160, 34, 12); ctx.fillStyle = PL; ctx.fill();
      // hood (behind drum)
      rr(58, 52, 344, 252, 42); ctx.fillStyle = PL; ctx.fill();
      const hg = ctx.createLinearGradient(0, 52, 0, 304);
      hg.addColorStop(0, "rgba(255,255,255,0.7)"); hg.addColorStop(1, "rgba(0,0,0,0.05)");
      rr(58, 52, 344, 252, 42); ctx.fillStyle = hg; ctx.fill();
    }

    function drawDrum() {
      ctx.beginPath(); ctx.arc(DR.x, DR.y, DR.r, 0, 7);
      ctx.fillStyle = dark ? "rgba(230,236,245,0.14)" : "rgba(255,255,255,0.5)"; ctx.fill();
      const vol = ctx.createRadialGradient(DR.x - 30, DR.y - 50, DR.r * 0.15, DR.x, DR.y + 20, DR.r * 1.15);
      vol.addColorStop(0, "rgba(255,255,255,0.5)"); vol.addColorStop(0.55, "rgba(0,0,0,0)"); vol.addColorStop(1, "rgba(0,0,0,0.14)");
      ctx.fillStyle = vol; ctx.fill();
      ctx.lineWidth = 6; ctx.strokeStyle = "rgba(255,255,255,0.75)"; ctx.stroke();
      ctx.lineWidth = 2; ctx.strokeStyle = "rgba(0,0,0,0.12)"; ctx.beginPath(); ctx.arc(DR.x, DR.y, DR.r - 3, 0, 7); ctx.stroke();
    }
    function drawGlare() {
      ctx.save(); ctx.beginPath(); ctx.arc(DR.x, DR.y, DR.r, 0, 7); ctx.clip();
      const g = ctx.createRadialGradient(DR.x - 58, DR.y - 68, 6, DR.x - 58, DR.y - 68, 120);
      g.addColorStop(0, "rgba(255,255,255,0.4)"); g.addColorStop(1, "rgba(255,255,255,0)");
      ctx.fillStyle = g; ctx.fillRect(0, 0, W, H);
      ctx.globalAlpha = 0.5; ctx.lineWidth = 5; ctx.strokeStyle = "rgba(255,255,255,0.6)";
      ctx.beginPath(); ctx.arc(DR.x, DR.y, DR.r - 4, Math.PI * 1.05, Math.PI * 1.42); ctx.stroke(); ctx.globalAlpha = 1;
      ctx.restore();
    }
    function drawBall(b) {
      let r = b.r;
      if (b.state === "tank") { r = R0 * LSCALE[b.layer]; ctx.globalAlpha = LALPHA[b.layer]; }
      ctx.beginPath(); ctx.arc(b.x, b.y, r, 0, 7); ctx.fillStyle = b.color; ctx.fill();
      ctx.beginPath(); ctx.arc(b.x, b.y, r * 0.6, 0, 7); ctx.fillStyle = "#fff"; ctx.fill();
      ctx.fillStyle = "#222"; ctx.textAlign = "center"; ctx.textBaseline = "middle";
      ctx.font = "700 " + Math.round(r * 0.85) + "px ui-sans-serif, system-ui, sans-serif";
      ctx.fillText(String(b.n), b.x, b.y + 1); ctx.globalAlpha = 1;
    }

    function render() {
      ctx.clearRect(0, 0, W, H);
      drawMachine();
      drawDrum();
      for (let L = 0; L < LAYERS; L++) for (const b of balls) if (b.state === "tank" && b.layer === L) drawBall(b);
      drawGlare();
      // result tray
      ctx.setLineDash([4, 5]); ctx.lineWidth = 2; ctx.strokeStyle = dark ? "#3a3f48" : "#d3d7de";
      for (const s of slots) { ctx.beginPath(); ctx.arc(s.x, s.y, SLOT_R, 0, 7); ctx.stroke(); }
      ctx.setLineDash([]);
      ctx.fillStyle = dark ? "#9aa0aa" : "#9096a0"; ctx.textAlign = "center"; ctx.textBaseline = "middle";
      ctx.font = "700 20px ui-sans-serif, system-ui, sans-serif"; ctx.fillText("+", plusX, TRAY_Y);
      ctx.font = "10px ui-sans-serif, system-ui, sans-serif"; ctx.fillText("보너스", slots[6].x, TRAY_Y + SLOT_R + 12);
      for (const b of balls) if (b.state === "flying" || b.state === "placed") drawBall(b);
    }

    function loop() { physics(); render(); requestAnimationFrame(loop); }

    function showResultBtns(on) { copyBtn.hidden = !on; saveBtn.hidden = !on; }
    function resetTank() {
      seedTank(); phase = "idle"; blow = 0; lastResult = null;
      showResultBtns(false); drawBtn.disabled = false;
      status.textContent = "공이 통 바닥에 가라앉아 있어요. 손잡이를 돌려(눌러) 뽑아보세요.";
    }
    function fly(n, slot) {
      const b = balls.find((x) => x.n === n && x.state === "tank"); if (!b) return;
      b.state = "flying"; b.f = 0; b.dur = 46; b.sx = b.x; b.sy = b.y; b.tx = slot.x; b.ty = slot.y;
    }
    function doDraw() {
      if (phase === "charging" || phase === "revealing") return;
      resetTank(); phase = "charging"; blow = 1.7; knobSpin = Math.PI * 2;
      drawBtn.disabled = true; showResultBtns(false); status.textContent = "추첨 중…";
      const pool = Array.from({ length: 45 }, (_, i) => i + 1);
      for (let i = pool.length - 1; i > 0; i--) { const j = (Math.random() * (i + 1)) | 0; [pool[i], pool[j]] = [pool[j], pool[i]]; }
      const six = pool.slice(0, 6).sort((a, b) => a - b), bonus = pool[6];
      const seq = [...six.map((n, i) => ({ n, slot: slots[i] })), { n: bonus, slot: slots[6] }];
      setTimeout(() => {
        phase = "revealing"; blow = 1.15;
        seq.forEach((item, i) => setTimeout(() => {
          fly(item.n, item.slot);
          if (i === seq.length - 1) setTimeout(() => {
            phase = "done"; blow = 0; lastResult = { six, bonus };
            drawBtn.disabled = false; showResultBtns(true);
            status.textContent = "당첨 번호  " + six.join(", ") + "   +   보너스 " + bonus;
          }, 780);
        }, i * 520));
      }, 1100);
    }

    // turn the knob to draw
    cv.addEventListener("click", (e) => {
      const rect = cv.getBoundingClientRect();
      const x = (e.clientX - rect.left) / rect.width * W, y = (e.clientY - rect.top) / rect.height * H;
      if (Math.hypot(x - KNOB.x, y - KNOB.y) <= KNOB.r) doDraw();
    });
    drawBtn.addEventListener("click", doDraw);
    resetBtn.addEventListener("click", resetTank);
    copyBtn.addEventListener("click", async () => {
      if (!lastResult) return;
      try {
        await navigator.clipboard.writeText(lastResult.six.join(", ") + "  +  보너스 " + lastResult.bonus);
        copyBtn.textContent = "복사됨!"; setTimeout(() => (copyBtn.textContent = "번호 복사"), 1200);
      } catch (e) {}
    });
    saveBtn.addEventListener("click", () => {
      const a = document.createElement("a");
      a.download = "lotto-" + (lastResult ? lastResult.six.join("-") : "draw") + ".png";
      a.href = cv.toDataURL("image/png"); a.click();
    });

    seedTank(); loop();
  }
</script>
