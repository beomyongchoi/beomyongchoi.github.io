---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { SITE } from "../../consts";
---

<BaseLayout
  title={`실험실 — ${SITE.authorKo}`}
  description="블로그 곁에서 굴려보는 소소한 사이드 프로젝트들. 8비트 마리오가 블록을 치며 뽑는 로또 추첨기."
  locale="ko"
  path="/playground/"
>
  <header class="mb-10">
    <h1 class="text-3xl font-bold tracking-tight sm:text-4xl">실험실</h1>
    <p class="mt-3 text-muted">블로그 곁에서 굴려보는 소소한 것들. Canvas·JS로 직접 만든 장난감.</p>
  </header>

  <section class="lab-card">
    <div class="lab-head">
      <h2>LUCKY BLOCK <span class="badge">로또 6 / 45</span></h2>
      <span class="lab-tag">Canvas 2D · 8-bit</span>
    </div>

    <canvas id="lotto" aria-label="8비트 로또"></canvas>

    <div class="lab-controls">
      <button id="lotto-draw" type="button" class="btn-primary">추첨 (GO!)</button>
      <button id="lotto-reset" type="button" class="btn-ghost">리셋</button>
      <button id="lotto-copy" type="button" class="btn-ghost" hidden>번호 복사</button>
      <button id="lotto-save" type="button" class="btn-ghost" hidden>이미지 저장</button>
    </div>
    <p id="lotto-status" class="lab-status">GO! 를 누르면 마리오가 달리며 블록을 칩니다.</p>
  </section>
</BaseLayout>

<style>
  .lab-card { border: 1px solid var(--border); border-radius: 16px; background: var(--surface); padding: 18px 18px 22px; }
  .lab-head { display: flex; align-items: center; justify-content: space-between; gap: 10px; margin-bottom: 12px; }
  .lab-head h2 { font-size: 1.05rem; font-weight: 700; font-family: var(--font-mono); letter-spacing: 0.02em; }
  .badge {
    font-size: 0.72rem; font-weight: 700; color: var(--accent);
    border: 1px solid color-mix(in srgb, var(--accent) 40%, var(--border));
    border-radius: 999px; padding: 1px 9px; margin-left: 6px; vertical-align: middle;
  }
  .lab-tag { font-size: 0.72rem; color: var(--muted); font-family: var(--font-mono); }
  #lotto {
    display: block; width: 100%; max-width: 520px; height: auto; aspect-ratio: 200 / 175;
    margin: 0 auto; image-rendering: pixelated; border-radius: 4px; border: 3px solid #202020;
  }
  .lab-controls { display: flex; flex-wrap: wrap; justify-content: center; gap: 10px; margin-top: 14px; }
  .btn-primary {
    font: inherit; font-weight: 700; padding: 9px 24px; border: 0; border-radius: 10px;
    background: var(--accent); color: var(--accent-fg); cursor: pointer; transition: opacity .15s, transform .05s;
  }
  .btn-primary:hover { opacity: 0.9; }
  .btn-primary:active { transform: translateY(1px); }
  .btn-primary:disabled { opacity: 0.45; cursor: not-allowed; }
  .btn-ghost {
    font: inherit; font-weight: 600; padding: 9px 18px; border: 1px solid var(--border); border-radius: 10px;
    background: transparent; color: var(--muted); cursor: pointer; transition: border-color .15s, color .15s;
  }
  .btn-ghost:hover { border-color: var(--accent); color: var(--accent); }
  .lab-status { margin-top: 12px; text-align: center; font-size: 0.9rem; color: var(--muted); min-height: 1.3em; }
</style>

<script>
  const cv = document.getElementById("lotto");
  if (cv && cv.getContext) {
    const ctx = cv.getContext("2d");
    const W = 200, H = 175;            // LOW internal res → chunky pixels via CSS upscale
    cv.width = W; cv.height = H;
    ctx.imageSmoothingEnabled = false;

    // palette
    const SKY = "#5c94fc", CLOUD = "#fff", HILL = "#4ec84e", HILL_D = "#2e9020";
    const GND = "#e08020", GND_D = "#a84808", GND_HI = "#f8b060", MORTAR = "#803008";
    const BLK = "#f8b020", BLK_HI = "#ffd868", BLK_D = "#a86008", USED = "#b06818", INK = "#201008";
    const ballColor = (n) => n <= 10 ? "#fbc400" : n <= 20 ? "#40a8f0" : n <= 30 ? "#f85858" : n <= 40 ? "#a8adb8" : "#78c828";

    const GROUND_Y = 146, BS = 16, BY = 44, R = 8;
    const bx = [12, 39, 66, 93, 120, 147, 176];
    const bcx = bx.map((x) => x + BS / 2);
    const slotY = 124, plusX = (bcx[5] + bcx[6]) / 2;

    const FONT = {
      "0": ["111", "101", "101", "101", "111"], "1": ["010", "110", "010", "010", "111"],
      "2": ["111", "001", "111", "100", "111"], "3": ["111", "001", "111", "001", "111"],
      "4": ["101", "101", "111", "001", "001"], "5": ["111", "100", "111", "001", "111"],
      "6": ["111", "100", "111", "101", "111"], "7": ["111", "001", "010", "010", "010"],
      "8": ["111", "101", "111", "101", "111"], "9": ["111", "101", "111", "001", "111"],
      "?": ["111", "001", "011", "000", "010"], "+": ["000", "010", "111", "010", "000"],
    };

    let blocks = [], balls = [], mario = null, phase = "idle", lastResult = null, tGlobal = 0;
    const status = document.getElementById("lotto-status");
    const drawBtn = document.getElementById("lotto-draw");
    const resetBtn = document.getElementById("lotto-reset");
    const copyBtn = document.getElementById("lotto-copy");
    const saveBtn = document.getElementById("lotto-save");

    const px = (x, y, w, h, c) => { ctx.fillStyle = c; ctx.fillRect(x | 0, y | 0, Math.max(1, w) | 0, Math.max(1, h) | 0); };
    function pxNum(s, cx, cy, sc, color) {
      const cw = (3 + 1) * sc, total = s.length * cw - sc, x0 = Math.round(cx - total / 2), y0 = Math.round(cy - (5 * sc) / 2);
      ctx.fillStyle = color; let x = x0;
      for (const ch of s) { const g = FONT[ch]; if (g) for (let r = 0; r < 5; r++) for (let c = 0; c < 3; c++) if (g[r][c] === "1") ctx.fillRect(x + c * sc, y0 + r * sc, sc, sc); x += cw; }
    }

    function resetBlocks() {
      blocks = bx.map((x, i) => ({ x, i, n: null, hit: false, hop: 0 }));
      balls = []; mario = null; phase = "idle"; lastResult = null;
    }

    // ---- scene ----
    function cloud(x, y) { px(x, y, 22, 6, CLOUD); px(x + 5, y - 4, 12, 5, CLOUD); px(x - 3, y + 3, 28, 4, CLOUD); }
    function hill(x, y, w) { px(x, y, w, 18, HILL); px(x + 4, y - 6, w - 8, 7, HILL); px(x + w * 0.35, y - 11, w * 0.3, 6, HILL); px(x, y + 14, w, 5, HILL_D); }
    function drawScene() {
      px(0, 0, W, H, SKY);
      cloud(28, 26); cloud(150, 20); cloud(100, 30);
      hill(-8, GROUND_Y - 18, 64); hill(150, GROUND_Y - 14, 74);
      px(0, GROUND_Y, W, H - GROUND_Y, GND); px(0, GROUND_Y, W, 3, GND_HI); px(0, GROUND_Y + 3, W, 2, GND_D);
      for (let y = GROUND_Y + 6; y < H; y += 10) px(0, y, W, 1, MORTAR);
      for (let x = 0; x < W; x += 16) px(x, GROUND_Y + 6, 1, H, MORTAR);
    }
    function drawBlock(b) {
      const y = BY - b.hop;
      if (b.hit) { px(b.x, y, BS, BS, USED); px(b.x, y, BS, 2, "#c88838"); px(b.x, y, BS, BS, USED); }
      else {
        px(b.x, y, BS, BS, BLK); px(b.x, y, BS, 2, BLK_HI); px(b.x, y + BS - 3, BS, 3, BLK_D);
        px(b.x, y, 1, BS, BLK_HI); px(b.x + BS - 1, y, 1, BS, BLK_D);
        px(b.x + 1, y + 1, 2, 2, INK); px(b.x + BS - 3, y + 1, 2, 2, INK);
        px(b.x + 1, y + BS - 3, 2, 2, INK); px(b.x + BS - 3, y + BS - 3, 2, 2, INK);
        pxNum("?", b.x + BS / 2, y + BS / 2, 2, "#fff");
      }
      px(b.x - 1, y - 1, BS + 2, 1, INK); px(b.x - 1, y + BS, BS + 2, 1, INK);
      px(b.x - 1, y, 1, BS, INK); px(b.x + BS, y, 1, BS, INK);
    }
    function drawSlot(cx) { px(cx - R - 1, slotY - R - 1, (R + 1) * 2, (R + 1) * 2, "rgba(0,0,0,0.18)"); }
    function drawBall(b, x, y) {
      ctx.beginPath(); ctx.arc(x, y, R, 0, 7); ctx.fillStyle = b.color; ctx.fill();
      px(x - 1, y - R, 2, 1, "rgba(255,255,255,0.6)");
      pxNum(String(b.n), x, y, 1, INK);
    }
    function drawMario(mx, my, jumping) {
      const RD = "#e02820", S = "#f8b878", HR = "#5a2c10", B = "#2848c8", SH = "#5a2c10", top = my - 15;
      px(mx - 4, top, 9, 3, RD); px(mx - 5, top + 3, 11, 2, RD);       // cap
      px(mx - 3, top + 5, 7, 4, S); px(mx - 4, top + 5, 2, 4, HR); px(mx + 1, top + 7, 4, 1, HR); // face
      px(mx - 4, top + 9, 8, 3, RD);                                   // shirt
      px(mx - 3, top + 11, 6, 3, B); px(mx - 3, top + 9, 2, 3, B); px(mx + 1, top + 9, 2, 3, B); // overalls
      px(mx - 6, top + 9, 2, 3, S); px(mx + 4, top + 9, 2, 3, S);      // arms
      if (jumping) { px(mx - 4, my - 2, 4, 2, SH); px(mx + 1, my - 2, 4, 2, SH); }
      else if (((mx | 0) >> 2) & 1) { px(mx - 4, my - 2, 4, 2, SH); px(mx + 2, my, 3, 2, SH); }
      else { px(mx, my - 2, 4, 2, SH); px(mx - 5, my, 3, 2, SH); }
    }

    function render() {
      drawScene();
      for (const cx of bcx) drawSlot(cx);
      for (const b of blocks) drawBlock(b);
      for (const b of balls) if (b.state === "placed") drawBall(b, b.p2x, b.p2y);
      for (const b of balls) if (b.state === "pop") {
        const e = Math.min(b.t, 1), u = 1 - e;
        drawBall(b, u * u * b.p0x + 2 * u * e * b.p1x + e * e * b.p2x, u * u * b.p0y + 2 * u * e * b.p1y + e * e * b.p2y);
      }
      if (mario && mario.on) drawMario(mario.x, GROUND_Y + mario.jy, mario.jump);
      pxNum("+", plusX, slotY, 2, "#fff");
      ctx.font = "700 8px ui-monospace, monospace"; ctx.textAlign = "center"; ctx.textBaseline = "middle";
      ctx.fillStyle = INK; ctx.fillText("★ LUCKY BLOCK ★", W / 2 + 1, 11);
      ctx.fillStyle = "#fff"; ctx.fillText("★ LUCKY BLOCK ★", W / 2, 10);
      ctx.font = "700 6px ui-monospace, monospace"; ctx.fillStyle = "#fff"; ctx.fillText("BONUS", bcx[6], slotY + R + 6);
    }

    function popBall(b) {
      const p0x = b.x + BS / 2, p0y = BY;
      balls.push({ n: b.n, color: ballColor(b.n), state: "pop", t: 0, p0x, p0y, p1x: p0x, p1y: BY - 22, p2x: bcx[b.i], p2y: slotY });
    }

    function tick() {
      tGlobal++;
      for (const b of balls) if (b.state === "pop") { b.t += 0.055; if (b.t >= 1) b.state = "placed"; }
      for (const b of blocks) if (b.hop > 0) b.hop = Math.max(0, b.hop - 0.9);
      if (mario && phase === "running") {
        mario.x += 0.9;
        if (!mario.jump) {
          const nb = blocks.find((b) => !b.hit && mario.x >= bcx[b.i] - 11);
          if (nb) { mario.jump = true; mario.jt = 0; mario.target = nb; }
        }
        if (mario.jump) {
          mario.jt++;
          mario.jy = -Math.sin((mario.jt / 24) * Math.PI) * 72;
          if (mario.jt === 12 && mario.target) { mario.target.hit = true; mario.target.hop = 6; popBall(mario.target); }
          if (mario.jt >= 24) { mario.jump = false; mario.jy = 0; mario.target = null; }
        }
        if (mario.x > W + 14 && blocks.every((b) => b.hit)) {
          mario.on = false; phase = "done";
          drawBtn.disabled = false; copyBtn.hidden = false; saveBtn.hidden = false;
          status.textContent = "당첨 번호  " + lastResult.six.join(", ") + "   +   보너스 " + lastResult.bonus;
        }
      }
      render(); requestAnimationFrame(tick);
    }

    function resetGame() {
      resetBlocks(); drawBtn.disabled = false; copyBtn.hidden = true; saveBtn.hidden = true;
      status.textContent = "GO! 를 누르면 마리오가 달리며 블록을 칩니다.";
    }
    function doDraw() {
      if (phase === "running") return;
      resetBlocks(); phase = "running"; drawBtn.disabled = true; copyBtn.hidden = true; saveBtn.hidden = true;
      status.textContent = "마리오 출발!";
      const pool = Array.from({ length: 45 }, (_, i) => i + 1);
      for (let i = pool.length - 1; i > 0; i--) { const j = (Math.random() * (i + 1)) | 0; [pool[i], pool[j]] = [pool[j], pool[i]]; }
      const six = pool.slice(0, 6).sort((a, b) => a - b), bonus = pool[6];
      blocks.forEach((b, i) => (b.n = i < 6 ? six[i] : bonus));
      lastResult = { six, bonus };
      mario = { x: -14, jy: 0, jump: false, jt: 0, target: null, on: true };
    }

    drawBtn.addEventListener("click", doDraw);
    resetBtn.addEventListener("click", resetGame);
    copyBtn.addEventListener("click", async () => {
      if (!lastResult) return;
      try { await navigator.clipboard.writeText(lastResult.six.join(", ") + "  +  보너스 " + lastResult.bonus);
        copyBtn.textContent = "복사됨!"; setTimeout(() => (copyBtn.textContent = "번호 복사"), 1200); } catch (e) {}
    });
    saveBtn.addEventListener("click", () => {
      const a = document.createElement("a");
      a.download = "lotto-" + (lastResult ? lastResult.six.join("-") : "draw") + ".png";
      a.href = cv.toDataURL("image/png"); a.click();
    });

    resetBlocks(); tick();
  }
</script>
