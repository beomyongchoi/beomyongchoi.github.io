---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { SITE } from "../../consts";
---

<BaseLayout
  title={`동적 서브에이전트 타임라인 시뮬레이터 — ${SITE.authorKo}`}
  description="Google Antigravity의 동적 서브에이전트(Dynamic Subagents) 병렬 오케스트레이션 타임라인을 시각적으로 시뮬레이션합니다. 파일 분할 처리 시 단일 스레드 대비 병렬 Gantt 차트 비교."
  locale="ko"
  path="/playground/agent-topology/"
>
  <header class="mb-5">
    <a href="/playground/" class="text-sm text-muted hover:text-accent">← 실험실</a>
    <h1 class="mt-3 text-3xl font-bold tracking-tight sm:text-4xl">서브에이전트 병렬 타임라인 시뮬레이터</h1>
    <p class="mt-3 text-muted">
      프로젝트 코드 파일 수와 서브에이전트 개수를 조절하고 [▶ Run Orchestration]을 누르면, 단일 스레드(Sequential) 대비 Antigravity 병렬 오케스트레이션의 **타임라인 Gantt 차트**가 실시간으로 비교 시각화됩니다.
    </p>
  </header>

  <section class="at-container" id="at">
    <div class="at-top">
      <a class="at-crosslink" href="/blog/agent-subagents-fanout/">개념 더 읽기 → 1. 병렬 오케스트레이션 — 동적 서브에이전트</a>
    </div>

    <!-- Controls -->
    <div class="at-controls-card">
      <div class="ctrl-group">
        <label class="ctrl-label">1. 처리 대상 코드 파일 수: <strong id="files-val">40 Files</strong></label>
        <input type="range" id="slider-files" min="10" max="100" value="40" step="10" class="at-slider" />
      </div>

      <div class="ctrl-group mt-4">
        <label class="ctrl-label">2. 동적 서브에이전트 (Subagents) 개수</label>
        <div class="btn-grid">
          <button type="button" class="at-cnt-btn" data-cnt="1">1개 (단일 스레드)</button>
          <button type="button" class="at-cnt-btn" data-cnt="2">2개 병렬</button>
          <button type="button" class="at-cnt-btn active" data-cnt="4">4개 병렬 (추천)</button>
        </div>
      </div>

      <div class="action-row mt-4">
        <button type="button" id="btn-run-at" class="execute-btn">▶ Run Multi-Agent Orchestration Simulation</button>
      </div>
    </div>

    <!-- Tokyo Night Terminal Screen & Gantt Canvas -->
    <div class="at-terminal">
      <div class="at-term-header">
        <span class="dot red"></span>
        <span class="dot yellow"></span>
        <span class="dot green"></span>
        <span class="at-term-title">antigravity --gantt-orchestration-monitor</span>
      </div>

      <div class="at-term-body">
        <div class="at-summary-row">
          <div class="sum-card">
            <span class="s-lbl">Sequential Total Time</span>
            <span id="at-seq-time" class="s-val red">24.0s</span>
          </div>
          <div class="sum-card">
            <span class="s-lbl">Antigravity Parallel Time</span>
            <span id="at-par-time" class="s-val green">6.8s</span>
          </div>
          <div class="sum-card">
            <span class="s-lbl">Orchestration Speedup</span>
            <span id="at-speedup-val" class="s-val green">3.53x Faster</span>
          </div>
        </div>

        <!-- Gantt Timeline Visualizer -->
        <div class="gantt-box">
          <div class="gantt-title">Execution Timeline (Gantt Chart Comparison)</div>
          
          <div class="gantt-stream" id="gantt-stream">
            <!-- Dynamic Gantt bars injected via JS -->
          </div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style is:global>
  .at-container { margin-top: 24px; }
  .at-top { display: flex; justify-content: space-between; margin-bottom: 16px; }
  .at-crosslink { font-size: 0.85rem; color: var(--accent); text-decoration: none; }
  .at-crosslink:hover { text-decoration: underline; }

  .at-controls-card {
    background: var(--surface); border: 1px solid var(--border); border-radius: 12px; padding: 20px; margin-bottom: 20px;
  }
  .ctrl-label { display: block; font-family: var(--font-mono); font-size: 0.82rem; color: var(--muted); margin-bottom: 8px; }
  .ctrl-label strong { color: var(--accent); }
  .at-slider { width: 100%; accent-color: var(--accent); cursor: pointer; }

  .btn-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(160px, 1fr)); gap: 10px; }
  .at-cnt-btn {
    font-family: var(--font-mono); font-size: 0.82rem; padding: 8px 12px;
    border: 1px solid var(--border); border-radius: 8px; background: var(--bg); color: var(--fg); cursor: pointer; transition: all 0.2s ease;
  }
  .at-cnt-btn:hover { border-color: var(--accent); color: var(--accent); }
  .at-cnt-btn.active { background: var(--accent); color: #fff; border-color: var(--accent); font-weight: 600; }

  .execute-btn {
    width: 100%; font-family: var(--font-mono); font-size: 0.9rem; font-weight: 700; padding: 12px;
    background: #7aa2f7; color: #1a1b26; border: none; border-radius: 8px; cursor: pointer; transition: background 0.2s ease;
  }
  .execute-btn:hover { background: #9ece6a; }

  .at-terminal {
    background: #1a1b26; border: 1px solid #2a2e42; border-radius: 12px;
    box-shadow: 0 8px 24px rgba(0,0,0,0.4); overflow: hidden; font-family: var(--font-mono); color: #a9b1d6;
  }
  .at-term-header {
    background: #16161e; padding: 10px 14px; display: flex; align-items: center; gap: 8px; border-bottom: 1px solid #2a2e42;
  }
  .dot { width: 10px; height: 10px; border-radius: 50%; display: inline-block; }
  .dot.red { background: #ff5f56; }
  .dot.yellow { background: #ffbd2e; }
  .dot.green { background: #27c93f; }
  .at-term-title { font-size: 0.75rem; color: #787c99; margin-left: 6px; }

  .at-term-body { padding: 20px; }
  .at-summary-row { display: grid; grid-template-columns: repeat(auto-fit, minmax(160px, 1fr)); gap: 14px; margin-bottom: 24px; }
  .sum-card { background: #16161e; border: 1px solid #2a2e42; border-radius: 8px; padding: 12px; }
  .s-lbl { display: block; font-size: 0.72rem; color: #787c99; margin-bottom: 4px; }
  .s-val { display: block; font-size: 1.2rem; font-weight: 700; }
  .s-val.green { color: #9ece6a; }
  .s-val.red { color: #f7768e; }

  .gantt-box { background: #16161e; border-radius: 8px; padding: 16px; border: 1px solid #2a2e42; }
  .gantt-title { font-size: 0.75rem; color: #787c99; margin-bottom: 14px; text-transform: uppercase; border-bottom: 1px dashed #2a2e42; padding-bottom: 6px; }
  .gantt-stream { display: flex; flex-direction: column; gap: 14px; }

  .gantt-track { display: flex; flex-direction: column; gap: 4px; }
  .track-label { font-size: 0.78rem; color: #c0caf5; display: flex; justify-content: space-between; }
  .track-bar-bg { background: #292e42; height: 16px; border-radius: 4px; overflow: hidden; position: relative; }
  .track-bar { height: 100%; background: #7aa2f7; width: 0%; transition: width 0.6s cubic-bezier(0.4, 0, 0.2, 1); }
  .track-bar.seq { background: #f7768e; }
  .track-bar.sub { background: #9ece6a; }
</style>

<script>
  let filesCount = 40;
  let subagentsCount = 4;

  const sliderFiles = document.getElementById('slider-files');
  const filesVal = document.getElementById('files-val');
  const cntBtns = document.querySelectorAll('.at-cnt-btn');
  const btnRun = document.getElementById('btn-run-at');

  const seqTimeEl = document.getElementById('at-seq-time');
  const parTimeEl = document.getElementById('at-par-time');
  const speedupValEl = document.getElementById('at-speedup-val');
  const ganttStream = document.getElementById('gantt-stream');

  sliderFiles.addEventListener('input', (e) => {
    filesCount = parseInt(e.target.value, 10);
    filesVal.textContent = `${filesCount} Files`;
  });

  cntBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      cntBtns.forEach(b => b.classList.remove('active'));
      btn.classList.add('active');
      subagentsCount = parseInt(btn.getAttribute('data-cnt'), 10);
    });
  });

  function runGanttSimulation() {
    ganttStream.innerHTML = '';

    const seqSec = (filesCount * 0.6).toFixed(1);
    const parSec = ((filesCount * 0.6) / subagentsCount + 0.8).toFixed(1);
    const speedup = (seqSec / parSec).toFixed(2);

    seqTimeEl.textContent = `${seqSec}s`;
    parTimeEl.textContent = `${parSec}s`;
    speedupValEl.textContent = `${speedup}x Faster`;

    // 1. Single Thread Sequential Bar
    const seqTrack = document.createElement('div');
    seqTrack.className = 'gantt-track';
    seqTrack.innerHTML = `
      <div class="track-label">
        <span>Single Agent (Sequential Execution)</span>
        <span>${seqSec}s total</span>
      </div>
      <div class="track-bar-bg">
        <div id="bar-seq" class="track-bar seq"></div>
      </div>
    `;
    ganttStream.appendChild(seqTrack);

    // 2. Multi-Agent Parallel Bars
    for (let i = 1; i <= subagentsCount; i++) {
      const track = document.createElement('div');
      track.className = 'gantt-track';
      track.innerHTML = `
        <div class="track-label">
          <span>Subagent ${i} (Branch Workspace #${i})</span>
          <span>${(parSec - 0.4).toFixed(1)}s</span>
        </div>
        <div class="track-bar-bg">
          <div id="bar-sub-${i}" class="track-bar sub"></div>
        </div>
      `;
      ganttStream.appendChild(track);
    }

    // Animate Progress Bars
    setTimeout(() => {
      const barSeq = document.getElementById('bar-seq');
      if (barSeq) barSeq.style.width = '100%';

      for (let i = 1; i <= subagentsCount; i++) {
        const barSub = document.getElementById(`bar-sub-${i}`);
        if (barSub) barSub.style.width = `${(100 / subagentsCount) * (1 + (i % 2) * 0.1)}%`;
      }
    }, 100);
  }

  btnRun.addEventListener('click', runGanttSimulation);
  runGanttSimulation();
</script>
