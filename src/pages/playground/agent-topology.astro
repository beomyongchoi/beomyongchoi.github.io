---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { SITE } from "../../consts";
---

<BaseLayout
  title={`동적 서브에이전트 위상 시각화 — ${SITE.authorKo}`}
  description="Google Antigravity의 동적 서브에이전트(Dynamic Subagents) 병렬 오케스트레이션을 시각적으로 확인합니다. 서브에이전트 개수와 실행 모드에 따른 처리 속도 및 작업 격리율 비교."
  locale="ko"
  path="/playground/agent-topology/"
>
  <header class="mb-5">
    <a href="/playground/" class="text-sm text-muted hover:text-accent">← 실험실</a>
    <h1 class="mt-3 text-3xl font-bold tracking-tight sm:text-4xl">동적 서브에이전트 위상 (Topology) 시각화</h1>
    <p class="mt-3 text-muted">
      메인 에이전트가 역학별 서브에이전트를 병렬 생성해 작업을 분산 처리하는 과정을 눈으로 확인해보세요.
    </p>
  </header>

  <section class="at-container" id="at">
    <div class="at-top">
      <a class="at-crosslink" href="/blog/agent-subagents-fanout/">개념 더 읽기 → 1. 병렬 오케스트레이션 — 동적 서브에이전트</a>
    </div>

    <!-- Controls -->
    <div class="at-controls">
      <div class="at-ctrl-group">
        <span class="ctrl-label">실행 모드:</span>
        <button type="button" class="at-mode-btn" data-mode="seq">Sequential (순차 실행)</button>
        <button type="button" class="at-mode-btn active" data-mode="parallel">Antigravity Parallel (병렬 분생)</button>
      </div>

      <div class="at-ctrl-group">
        <span class="ctrl-label">서브에이전트 수:</span>
        <button type="button" class="at-count-btn" data-count="1">1개</button>
        <button type="button" class="at-count-btn" data-count="2">2개</button>
        <button type="button" class="at-count-btn active" data-count="3">3개</button>
        <button type="button" class="at-count-btn" data-count="4">4개</button>
      </div>
    </div>

    <!-- Tokyo Night Terminal Screen -->
    <div class="at-terminal">
      <div class="at-term-header">
        <span class="dot red"></span>
        <span class="dot yellow"></span>
        <span class="dot green"></span>
        <span class="at-term-title">antigravity --orchestrate-subagents</span>
      </div>

      <div class="at-term-body">
        <div class="at-dag-tree" id="at-tree">
          <!-- Main Orchestrator Node -->
          <div class="dag-node main-node">
            <span class="node-tag">Main Orchestrator Agent</span>
            <span class="node-status">ACTIVE</span>
          </div>

          <div class="dag-branches" id="dag-branches">
            <!-- Dynamic subagent branch items rendered via JS -->
          </div>
        </div>

        <div class="at-metrics">
          <div class="at-metric-card">
            <span class="m-title">Total Turnaround Latency</span>
            <span id="at-latency" class="m-value">1.8s</span>
          </div>

          <div class="at-metric-card">
            <span class="m-title">Context Isolation Index</span>
            <span id="at-isolation" class="m-value">100% (Branch Mode)</span>
          </div>

          <div class="at-metric-card">
            <span class="m-title">Parallel Speedup Factor</span>
            <span id="at-speedup" class="m-value">2.9x Fast</span>
          </div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style is:global>
  .at-container { margin-top: 24px; }
  .at-top { display: flex; justify-content: space-between; margin-bottom: 16px; }
  .at-crosslink { font-size: 0.85rem; color: var(--accent); text-decoration: none; }
  .at-crosslink:hover { text-decoration: underline; }

  .at-controls { display: flex; gap: 20px; flex-wrap: wrap; margin-bottom: 20px; background: var(--surface); padding: 14px 18px; border-radius: 10px; border: 1px solid var(--border); }
  .at-ctrl-group { display: flex; align-items: center; gap: 8px; }
  .ctrl-label { font-family: var(--font-mono); font-size: 0.8rem; color: var(--muted); }

  .at-mode-btn, .at-count-btn {
    font-family: var(--font-mono); font-size: 0.8rem; padding: 6px 12px;
    border: 1px solid var(--border); border-radius: 6px; background: var(--bg);
    color: var(--fg); cursor: pointer; transition: all 0.2s ease;
  }
  .at-mode-btn:hover, .at-count-btn:hover { border-color: var(--accent); color: var(--accent); }
  .at-mode-btn.active, .at-count-btn.active { background: var(--accent); color: #fff; border-color: var(--accent); font-weight: 600; }

  .at-terminal {
    background: #1a1b26; border: 1px solid #2a2e42; border-radius: 12px;
    box-shadow: 0 8px 24px rgba(0,0,0,0.4); overflow: hidden; font-family: var(--font-mono); color: #a9b1d6;
  }
  .at-term-header {
    background: #16161e; padding: 10px 14px; display: flex; align-items: center; gap: 8px;
    border-bottom: 1px solid #2a2e42;
  }
  .dot { width: 10px; height: 10px; border-radius: 50%; display: inline-block; }
  .dot.red { background: #ff5f56; }
  .dot.yellow { background: #ffbd2e; }
  .dot.green { background: #27c93f; }
  .at-term-title { font-size: 0.75rem; color: #787c99; margin-left: 6px; }

  .at-term-body { padding: 24px; }
  .at-dag-tree { display: flex; flex-direction: column; align-items: center; gap: 16px; margin-bottom: 24px; }

  .dag-node {
    background: #16161e; border: 1px solid #7aa2f7; border-radius: 8px; padding: 10px 16px;
    display: flex; justify-content: space-between; align-items: center; width: 100%; max-width: 500px;
  }
  .dag-node.main-node { border-color: #bb9af7; background: #1f1d2e; }
  .node-tag { font-size: 0.85rem; font-weight: 600; color: #c0caf5; }
  .node-status { font-size: 0.7rem; padding: 2px 6px; border-radius: 4px; background: #27c93f22; color: #9ece6a; }

  .dag-branches { display: flex; flex-direction: column; gap: 10px; width: 100%; max-width: 500px; }
  .branch-card {
    background: #16161e; border: 1px dashed #2a2e42; border-radius: 8px; padding: 10px 14px;
    font-size: 0.8rem; display: flex; flex-direction: column; gap: 6px; transition: all 0.3s ease;
  }
  .branch-card.active { border-style: solid; border-color: #7aa2f7; background: #181926; }
  .branch-header { display: flex; justify-content: space-between; }
  .branch-name { color: #7aa2f7; font-weight: 600; }
  .branch-ws { color: #787c99; font-size: 0.72rem; }
  .branch-progress-bg { background: #292e42; height: 5px; border-radius: 3px; overflow: hidden; }
  .branch-progress { height: 100%; background: #9ece6a; width: 100%; transition: width 0.4s ease; }

  .at-metrics { display: grid; grid-template-columns: repeat(auto-fit, minmax(160px, 1fr)); gap: 14px; }
  .at-metric-card { background: #16161e; border: 1px solid #2a2e42; border-radius: 8px; padding: 12px; }
  .m-title { display: block; font-size: 0.72rem; color: #787c99; margin-bottom: 4px; }
  .m-value { display: block; font-size: 1.1rem; font-weight: 700; color: #9ece6a; }
</style>

<script>
  const subagentPresets = [
    { name: "Subagent 1: Code Explorer", ws: "branch/explorer-workspace" },
    { name: "Subagent 2: Test Suite Writer", ws: "branch/test-workspace" },
    { name: "Subagent 3: Core Refactor Engine", ws: "branch/refactor-workspace" },
    { name: "Subagent 4: Security Auditor", ws: "branch/security-workspace" }
  ];

  let currentMode = "parallel";
  let currentCount = 3;

  const modeBtns = document.querySelectorAll('.at-mode-btn');
  const countBtns = document.querySelectorAll('.at-count-btn');
  const branchesContainer = document.getElementById('dag-branches');
  const latencyEl = document.getElementById('at-latency');
  const isolationEl = document.getElementById('at-isolation');
  const speedupEl = document.getElementById('at-speedup');

  function renderTopology() {
    branchesContainer.innerHTML = '';
    const selected = subagentPresets.slice(0, currentCount);

    selected.forEach((sub, idx) => {
      const card = document.createElement('div');
      card.className = 'branch-card active';
      card.innerHTML = `
        <div class="branch-header">
          <span class="branch-name">${sub.name}</span>
          <span class="branch-ws">${sub.ws}</span>
        </div>
        <div class="branch-progress-bg">
          <div class="branch-progress" style="width: ${currentMode === 'parallel' ? '100%' : ((idx + 1) * (100 / currentCount)) + '%'};"></div>
        </div>
      `;
      branchesContainer.appendChild(card);
    });

    if (currentMode === 'parallel') {
      const baseLat = (1.2 + (currentCount * 0.2)).toFixed(1);
      latencyEl.textContent = `${baseLat}s`;
      isolationEl.textContent = "100% (Isolated Branches)";
      speedupEl.textContent = `${(currentCount * 0.95).toFixed(1)}x Speedup`;
    } else {
      const seqLat = (1.5 * currentCount).toFixed(1);
      latencyEl.textContent = `${seqLat}s`;
      isolationEl.textContent = "25% (Shared Thread Risk)";
      speedupEl.textContent = "1.0x (Sequential)";
    }
  }

  modeBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      modeBtns.forEach(b => b.classList.remove('active'));
      btn.classList.add('active');
      currentMode = btn.getAttribute('data-mode');
      renderTopology();
    });
  });

  countBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      countBtns.forEach(b => b.classList.remove('active'));
      btn.classList.add('active');
      currentCount = parseInt(btn.getAttribute('data-count'), 10);
      renderTopology();
    });
  });

  renderTopology();
</script>
