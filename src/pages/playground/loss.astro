---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { SITE } from "../../consts";
---

<BaseLayout
  title={`손실 함수 — 틀림을 숫자로 — ${SITE.authorKo}`}
  description="예측 슬라이더를 움직이면 제곱 오차 포물선 위의 점이 따라 움직입니다. 확률 모드로 바꾸면 −log p가 0 근처에서 폭발하는 걸 볼 수 있어요. 모델이 배우려면 먼저 틀림을 점수로 만들어야 합니다. 모델은 어떻게 배우나 시리즈 0편."
  locale="ko"
  path="/playground/loss/"
>
  <header class="mb-5">
    <a href="/playground/" class="text-sm text-muted hover:text-accent">← 실험실</a>
    <h1 class="mt-3 text-3xl font-bold tracking-tight sm:text-4xl">손실 — 틀림을 숫자로</h1>
    <p class="mt-3 text-muted">
      <strong>예측을 슬라이더로</strong> 움직여보세요. 틀릴수록 손실이 커지고, 정답에 닿으면 <strong>0</strong>이 됩니다.
    </p>
  </header>

  <section class="ls">
    <div class="ls-top">
      <a class="ls-crosslink" href="/blog/loss-function/">개념 더 읽기 → 손실 — 틀림을 숫자로 (0편)</a>
    </div>

    <div class="ls-stage">
      <div class="ls-canvas"><svg id="ls-svg"></svg></div>

      <div class="ls-side">
        <div class="ls-toggle" id="ls-toggle">
          <button data-m="mse" class="on">숫자 예측</button>
          <button data-m="xent">확률 예측</button>
        </div>

        <div class="ls-ctrl" id="ls-ctrl-mse">
          <label>내 예측 <b id="ls-predv">4.0</b> <span class="ls-dim">(정답 7)</span></label>
          <input type="range" id="ls-pred" min="0" max="14" step="0.1" value="4" />
        </div>
        <div class="ls-ctrl" id="ls-ctrl-xent" hidden>
          <label>정답에 준 확률 p = <b id="ls-pv">0.50</b></label>
          <input type="range" id="ls-p" min="0.01" max="1" step="0.01" value="0.5" />
        </div>

        <div class="ls-loss">
          <span class="ls-loss-lbl" id="ls-formula">(예측 − 정답)²</span>
          <span class="ls-loss-val" id="ls-lossv">9.0</span>
        </div>

        <div class="ls-calc" id="ls-calc"></div>
      </div>
    </div>

    <p class="ls-note" id="ls-note"></p>

    <p class="ls-foot">
      이제 어떤 <strong>W</strong>든 점수를 매길 수 있어요. 다음 질문은 "더 나은 W를 <strong>어떻게 찾나</strong>" — 답은 이 곡선의 <strong>내리막</strong>을 따라가는 겁니다. 그게 경사하강(1편).
      <a href="/blog/loss-function/">개념 다시 읽기 → 손실 — 틀림을 숫자로</a>
    </p>
  </section>
</BaseLayout>

<style is:global>
  .ls-top { margin-bottom: 14px; }
  .ls-crosslink { font-size: 0.82rem; color: var(--accent); text-decoration: none; }
  .ls-crosslink:hover { text-decoration: underline; }

  .ls-stage { display: grid; grid-template-columns: minmax(0, 1fr) 236px; gap: 18px; align-items: start; }
  @media (max-width: 640px) { .ls-stage { grid-template-columns: 1fr; } }

  .ls-canvas { border: 1px solid var(--border); border-radius: 12px; background: var(--surface); overflow: hidden; }
  #ls-svg { display: block; width: 100%; height: auto; }

  .ls-side { font-family: var(--font-mono); }
  .ls-toggle { display: flex; border: 1px solid var(--border); border-radius: 9px; overflow: hidden; margin-bottom: 14px; }
  .ls-toggle button { flex: 1; font: inherit; font-size: 0.76rem; font-weight: 600; padding: 7px 4px; background: transparent; color: var(--muted); border: 0; cursor: pointer; }
  .ls-toggle button.on { background: var(--accent); color: var(--accent-fg); }

  .ls-ctrl { margin-bottom: 14px; }
  .ls-ctrl label { font-size: 0.8rem; display: block; margin-bottom: 6px; }
  .ls-ctrl label b { color: var(--accent); }
  .ls-dim { color: var(--muted); font-size: 0.74rem; }
  .ls-ctrl input[type=range] { width: 100%; accent-color: var(--accent); }

  .ls-loss { display: flex; align-items: baseline; justify-content: space-between; gap: 8px; padding: 9px 13px; border-radius: 9px; background: var(--bg); border: 1px solid var(--border); margin-bottom: 12px; }
  .ls-loss-lbl { font-size: 0.78rem; font-weight: 700; }
  .ls-loss-val { font-size: 1.55rem; font-weight: 800; color: var(--accent); }
  .ls-loss-val.zero { color: #1a7a52; }
  .ls-loss-val.hot { color: #b53c28; }

  .ls-calc { font-size: 0.82rem; color: var(--muted); line-height: 1.8; padding: 10px 13px; border: 1px solid var(--border); border-radius: 9px; background: var(--bg); min-height: 66px; }
  .ls-calc b { color: var(--fg); }

  .ls-note { margin-top: 16px; font-size: 0.88rem; color: var(--fg); background: var(--surface); border-left: 3px solid var(--accent); border-radius: 0 8px 8px 0; padding: 11px 15px; line-height: 1.65; }
  .ls-note b { color: var(--accent); }

  .ls-foot { margin-top: 26px; padding-top: 18px; border-top: 1px solid var(--border); font-size: 0.86rem; color: var(--muted); line-height: 1.6; }
  .ls-foot a { display: inline-block; margin-top: 4px; color: var(--accent); text-decoration: none; font-family: var(--font-mono); font-size: 0.82rem; }
  .ls-foot a:hover { text-decoration: underline; }
</style>

<script>
  const $ = (id) => document.getElementById(id);
  const svg = $("ls-svg");

  const W = 520, H = 380, padL = 46, padR = 20, padT = 22, padB = 34;
  const ANSWER = 7;

  let mode = "mse", pred = 4, p = 0.5;

  // ── domain per mode ──
  // mse: x = prediction in [0,14], y = (x-7)^2 in [0,49]
  // xent: x = p in (0,1], y = -ln(p), plot up to y=5 (p=0.0067)
  function domain() {
    return mode === "mse"
      ? { x0: 0, x1: 14, y0: 0, y1: 50, fx: (x) => (x - ANSWER) ** 2 }
      : { x0: 0, x1: 1, y0: 0, y1: 5, fx: (x) => (x <= 0.006 ? 5 : Math.min(5, -Math.log(x))) };
  }
  const PX = (d, x) => padL + (x - d.x0) / (d.x1 - d.x0) * (W - padL - padR);
  const PY = (d, y) => H - padB - (y - d.y0) / (d.y1 - d.y0) * (H - padT - padB);

  function draw() {
    const cs = getComputedStyle(document.documentElement), g = (n, f) => cs.getPropertyValue(n).trim() || f;
    const acc = g("--accent", "#2b4a7e"), muted = g("--muted", "#6b6f76"), border = g("--border", "#e5e6e9");
    const grn = "#1a7a52", red = "#b53c28";
    const d = domain();
    let s = "";

    // axes
    s += `<line x1="${padL}" y1="${H - padB}" x2="${W - padR}" y2="${H - padB}" stroke="${muted}" stroke-width="1.2"/>`;
    s += `<line x1="${padL}" y1="${padT}" x2="${padL}" y2="${H - padB}" stroke="${muted}" stroke-width="1.2"/>`;
    // y grid + labels
    const ySteps = mode === "mse" ? [0, 10, 20, 30, 40, 50] : [0, 1, 2, 3, 4, 5];
    ySteps.forEach((yv) => {
      const y = PY(d, yv);
      s += `<line x1="${padL}" y1="${y}" x2="${W - padR}" y2="${y}" stroke="${border}" stroke-width="0.7"/>`;
      s += `<text x="${padL - 7}" y="${y + 4}" font-family="ui-monospace,monospace" font-size="10.5" fill="${muted}" text-anchor="end">${yv}</text>`;
    });
    // x labels
    const xSteps = mode === "mse" ? [0, 3.5, 7, 10.5, 14] : [0, 0.25, 0.5, 0.75, 1];
    xSteps.forEach((xv) => {
      s += `<text x="${PX(d, xv)}" y="${H - padB + 16}" font-family="ui-monospace,monospace" font-size="10.5" fill="${muted}" text-anchor="middle">${xv}</text>`;
    });
    s += `<text x="${W - padR}" y="${H - padB - 8}" font-family="ui-monospace,monospace" font-size="11" fill="${muted}" text-anchor="end">${mode === "mse" ? "prediction" : "p(correct)"}</text>`;
    s += `<text x="${padL + 8}" y="${padT + 4}" font-family="ui-monospace,monospace" font-size="11" fill="${muted}">loss</text>`;

    // curve
    let path = "";
    const N = 240;
    for (let i = 0; i <= N; i++) {
      const x = d.x0 + (d.x1 - d.x0) * (i / N);
      const xx = mode === "xent" ? Math.max(0.006, x) : x;
      const y = Math.min(d.y1, d.fx(xx));
      path += `${i ? "L" : "M"}${PX(d, x).toFixed(1)},${PY(d, y).toFixed(1)} `;
    }
    s += `<path d="${path}" fill="none" stroke="${acc}" stroke-width="2.5"/>`;

    // markers
    if (mode === "mse") {
      // answer line at x=7 (loss 0)
      s += `<line x1="${PX(d, ANSWER)}" y1="${padT}" x2="${PX(d, ANSWER)}" y2="${H - padB}" stroke="${grn}" stroke-width="1.3" stroke-dasharray="4 3"/>`;
      s += `<text x="${PX(d, ANSWER)}" y="${padT + 12}" font-family="ui-monospace,monospace" font-size="11" font-weight="700" fill="${grn}" text-anchor="middle">answer = 7</text>`;
    } else {
      s += `<line x1="${PX(d, 1)}" y1="${PY(d, 0) - 2}" x2="${PX(d, 1)}" y2="${PY(d, 0) + 2}" stroke="${grn}" stroke-width="2"/>`;
      s += `<text x="${PX(d, 0.985)}" y="${PY(d, 0) - 8}" font-family="ui-monospace,monospace" font-size="10.5" font-weight="700" fill="${grn}" text-anchor="end">p=1, loss 0</text>`;
      s += `<text x="${PX(d, 0.05)}" y="${padT + 12}" font-family="ui-monospace,monospace" font-size="10.5" font-weight="700" fill="${red}">p→0: explodes</text>`;
    }

    // current point
    const cx0 = mode === "mse" ? pred : p;
    const cy0 = Math.min(d.y1, d.fx(mode === "xent" ? Math.max(0.006, cx0) : cx0));
    const hot = mode === "mse" ? cy0 > 25 : cy0 > 2.2;
    const zero = cy0 < 0.02;
    const dotCol = zero ? grn : hot ? red : acc;
    // drop lines
    s += `<line x1="${PX(d, cx0)}" y1="${H - padB}" x2="${PX(d, cx0)}" y2="${PY(d, cy0)}" stroke="${dotCol}" stroke-width="1" stroke-dasharray="3 3"/>`;
    s += `<line x1="${padL}" y1="${PY(d, cy0)}" x2="${PX(d, cx0)}" y2="${PY(d, cy0)}" stroke="${dotCol}" stroke-width="1" stroke-dasharray="3 3"/>`;
    s += `<circle cx="${PX(d, cx0)}" cy="${PY(d, cy0)}" r="7" fill="${dotCol}" stroke="#fff" stroke-width="2.5"/>`;

    svg.setAttribute("viewBox", `0 0 ${W} ${H}`);
    svg.innerHTML = s;
    readout(cy0, zero, hot);
  }

  function readout(lossVal, zero, hot) {
    const lv = $("ls-lossv");
    lv.className = "ls-loss-val " + (zero ? "zero" : hot ? "hot" : "");
    if (mode === "mse") {
      const err = pred - ANSWER;
      $("ls-formula").textContent = "(예측 − 정답)²";
      lv.textContent = (err * err).toFixed(1);
      $("ls-calc").innerHTML = `오차 = ${pred.toFixed(1)} − ${ANSWER} = <b>${err.toFixed(1)}</b><br>손실 = (${err.toFixed(1)})² = <b>${(err * err).toFixed(2)}</b>`;
      $("ls-note").innerHTML = zero
        ? `정답에 딱 맞으면 손실 <b>0</b>. 여기가 이 곡선의 <b>바닥</b>입니다 — 학습이 도착하고 싶은 곳.`
        : `오차 <b>${Math.abs(err).toFixed(1)}</b>이 제곱돼 손실 <b>${(err * err).toFixed(1)}</b>. 두 배 더 틀리면 손실은 <b>네 배</b> — 크게 틀릴수록 훨씬 아프게 설계돼 있어요. 방향(±)은 제곱 때문에 상관없습니다.`;
    } else {
      $("ls-formula").textContent = "−log p";
      lv.textContent = (-Math.log(p)).toFixed(2);
      $("ls-calc").innerHTML = `p(정답) = <b>${p.toFixed(2)}</b><br>손실 = −log(${p.toFixed(2)}) = <b>${(-Math.log(p)).toFixed(2)}</b>`;
      $("ls-note").innerHTML = p >= 0.99
        ? `정답에 확률 <b>1</b>을 주면 손실 <b>0</b> — 확신하고 맞히면 공짜입니다.`
        : p <= 0.05
        ? `정답에 겨우 <b>${p.toFixed(2)}</b>를 줬습니다 — 손실이 <b>폭발</b>합니다. "확신하며 틀리기"가 가장 비싼 이유. GPT의 다음 토큰 학습이 정확히 이 점수로 굴러갑니다.`
        : `정답에 <b>${(p * 100).toFixed(0)}%</b>를 줬을 때 손실 <b>${(-Math.log(p)).toFixed(2)}</b>. p가 반으로 줄 때마다 손실은 일정하게(+0.69) 늘어요 — log의 성질입니다.`;
    }
  }

  $("ls-toggle").querySelectorAll("button").forEach((b) =>
    b.addEventListener("click", () => {
      mode = b.dataset.m;
      $("ls-toggle").querySelectorAll("button").forEach((x) => x.classList.toggle("on", x === b));
      $("ls-ctrl-mse").hidden = mode !== "mse";
      $("ls-ctrl-xent").hidden = mode !== "xent";
      draw();
    }));
  $("ls-pred").addEventListener("input", (e) => { pred = +e.target.value; $("ls-predv").textContent = pred.toFixed(1); draw(); });
  $("ls-p").addEventListener("input", (e) => { p = +e.target.value; $("ls-pv").textContent = p.toFixed(2); draw(); });

  window.addEventListener("resize", draw);
  draw();
</script>
