---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { SITE } from "../../consts";
---

<BaseLayout
  title={`행렬곱 = 내적의 묶음 — ${SITE.authorKo}`}
  description="출력 셀을 클릭하면 A의 한 행과 B의 한 열이 켜지고, 그 셀이 둘의 내적으로 채워집니다. 행렬곱이 '내적을 한꺼번에 잔뜩' 돌리는 일이라는 걸 눈으로. 행렬로 생각하기 시리즈 1편."
  locale="ko"
  path="/playground/matmul/"
>
  <header class="mb-5">
    <a href="/playground/" class="text-sm text-muted hover:text-accent">← 실험실</a>
    <h1 class="mt-3 text-3xl font-bold tracking-tight sm:text-4xl">행렬곱 = 내적의 묶음</h1>
    <p class="mt-3 text-muted">
      결과 행렬 <strong>C</strong>의 셀을 <strong>클릭</strong>해보세요. <strong class="mm-a">A의 행</strong>과 <strong class="mm-b">B의 열</strong>이 켜지고, 그 셀은 둘의 <strong>내적</strong>으로 채워집니다.
    </p>
  </header>

  <section class="mm">
    <div class="mm-top">
      <a class="mm-crosslink" href="/blog/matrix-transform/">개념 더 읽기 → 행렬 = 한 번에 변환 (1편)</a>
    </div>

    <div class="mm-stage">
      <div class="mm-canvas"><svg id="mm-svg"></svg></div>

      <div class="mm-side">
        <button class="mm-play" id="mm-play">▶ 전체 채우기</button>
        <p class="mm-hint">셀을 클릭하면 그 셀만, ▶를 누르면 4칸을 차례로 채웁니다.</p>
        <div class="mm-calc" id="mm-calc"></div>
      </div>
    </div>

    <p class="mm-note" id="mm-note"></p>

    <p class="mm-foot">
      같은 행렬 <strong>W</strong>를 토큰 벡터 수천 개에 한꺼번에 곱하는 게 <strong>하나의 행렬곱</strong>이에요 — 어텐션의 <strong class="mm-a">Q</strong>=X·W도 이겁니다. 다음 편에선 행렬이 <strong>공간을 휘는</strong> 걸 봅니다.
      <a href="/blog/matrix-transform/">개념 다시 읽기 → 행렬 = 한 번에 변환</a>
    </p>
  </section>
</BaseLayout>

<style is:global>
  .mm-a { color: var(--accent); }
  .mm-b { color: #1a7a52; }
  .mm-top { margin-bottom: 14px; }
  .mm-crosslink { font-size: 0.82rem; color: var(--accent); text-decoration: none; }
  .mm-crosslink:hover { text-decoration: underline; }

  .mm-stage { display: grid; grid-template-columns: minmax(0, 1.1fr) 240px; gap: 18px; align-items: start; }
  @media (max-width: 640px) { .mm-stage { grid-template-columns: 1fr; } }

  .mm-canvas { border: 1px solid var(--border); border-radius: 12px; background: var(--surface); overflow: hidden; }
  #mm-svg { display: block; width: 100%; height: auto; }

  .mm-side { font-family: var(--font-mono); }
  .mm-play { font: inherit; font-size: 0.82rem; font-weight: 700; width: 100%; padding: 9px; border: 1px solid var(--accent); border-radius: 9px; background: var(--accent); color: var(--accent-fg); cursor: pointer; }
  .mm-play.on { background: var(--surface); color: var(--accent); }
  .mm-hint { font-size: 0.74rem; color: var(--muted); margin: 8px 0 12px; line-height: 1.5; }
  .mm-calc { font-size: 0.9rem; line-height: 1.9; min-height: 90px; padding: 12px 14px; border: 1px solid var(--border); border-radius: 10px; background: var(--bg); }
  .mm-calc .lbl { color: var(--muted); font-size: 0.8rem; }
  .mm-calc .ra { color: var(--accent); font-weight: 700; }
  .mm-calc .rb { color: #1a7a52; font-weight: 700; }
  .mm-calc .eq { font-size: 1.35rem; font-weight: 800; color: var(--fg); }
  .mm-calc .dim { color: var(--muted); }

  .mm-note { margin-top: 16px; font-size: 0.88rem; color: var(--fg); background: var(--surface); border-left: 3px solid var(--accent); border-radius: 0 8px 8px 0; padding: 11px 15px; line-height: 1.65; }
  .mm-note b { color: var(--accent); }

  .mm-foot { margin-top: 26px; padding-top: 18px; border-top: 1px solid var(--border); font-size: 0.86rem; color: var(--muted); line-height: 1.6; }
  .mm-foot a { display: inline-block; margin-top: 4px; color: var(--accent); text-decoration: none; font-family: var(--font-mono); font-size: 0.82rem; }
  .mm-foot a:hover { text-decoration: underline; }
</style>

<script>
  const $ = (id) => document.getElementById(id);
  const svg = $("mm-svg");

  // A (2x3) · B (3x2) = C (2x2). Middle dim k=3 → each output cell is a 3-term dot product.
  const A = [[1, 2, 0], [0, 1, 3]];
  const B = [[2, 1], [1, 0], [4, 2]];
  const M = 2, K = 3, N = 2;
  const C = Array.from({ length: M }, (_, i) =>
    Array.from({ length: N }, (_, j) => A[i].reduce((s, _v, k) => s + A[i][k] * B[k][j], 0)));

  let sel = { i: 0, j: 0 };
  const filled = new Set(["0,0"]);   // which C cells are revealed
  let playing = false, timer = null;

  // layout: step grid; B sits above C, A sits left of C (schoolbook alignment)
  const step = 44, cell = 40, pad = 16;
  const Ax = pad, By = pad + 8;              // top room for the "B (3x2)" label
  const Cx = Ax + K * step + 26;
  const Cy = By + K * step + 26;
  const Wd = Cx + N * step + pad + 12;       // right room for the column highlight band
  const Ht = Cy + M * step + pad - 4;

  function cellRect(x, y, txt, opt) {
    const o = opt || {};
    const fill = o.fill || "var(--bg)", stroke = o.stroke || "var(--border)", sw = o.sw || 1;
    const tcol = o.tcol || "var(--fg)", fw = o.fw || 400, cursor = o.cursor ? ' style="cursor:pointer"' : "";
    return `<g${cursor}${o.data || ""}><rect x="${x}" y="${y}" width="${cell}" height="${cell}" rx="6" fill="${fill}" stroke="${stroke}" stroke-width="${sw}"/>` +
      `<text x="${x + cell / 2}" y="${y + cell / 2}" font-family="ui-monospace,monospace" font-size="16" font-weight="${fw}" fill="${tcol}" text-anchor="middle" dominant-baseline="central">${txt}</text></g>`;
  }
  const lbl = (x, y, t, col) => `<text x="${x}" y="${y}" font-family="ui-monospace,monospace" font-size="12.5" font-weight="700" fill="${col}" text-anchor="middle">${t}</text>`;

  function draw() {
    const cs = getComputedStyle(document.documentElement), g = (n, f) => cs.getPropertyValue(n).trim() || f;
    const acc = g("--accent", "#2b4a7e"), grn = "#1a7a52", muted = g("--muted", "#6b6f76");
    const accSoft = "color-mix(in srgb, " + acc + " 16%, var(--bg))";
    const grnSoft = "color-mix(in srgb, #22a06b 18%, var(--bg))";
    let s = "";

    // highlight bands: A's selected row, B's selected column
    s += `<rect x="${Ax - 5}" y="${Cy + sel.i * step - 5}" width="${K * step + 8}" height="${cell + 10}" rx="9" fill="${acc}" opacity="0.08"/>`;
    s += `<rect x="${Cx + sel.j * step - 5}" y="${By - 5}" width="${cell + 10}" height="${K * step + 8}" rx="9" fill="#22a06b" opacity="0.10"/>`;

    // B (top-right)
    s += lbl(Cx + (N * step - step + cell) / 2, By - 8, "B  (3×2)", grn);
    for (let r = 0; r < K; r++) for (let j = 0; j < N; j++) {
      const on = j === sel.j;
      s += cellRect(Cx + j * step, By + r * step, B[r][j], { fill: on ? grnSoft : "var(--bg)", stroke: on ? "#22a06b" : "var(--border)", sw: on ? 2 : 1, tcol: on ? grn : "var(--fg)", fw: on ? 700 : 400 });
    }

    // A (bottom-left)
    s += lbl(Ax + (K * step - step + cell) / 2, Cy - 8, "A  (2×3)", acc);
    for (let i = 0; i < M; i++) for (let k = 0; k < K; k++) {
      const on = i === sel.i;
      s += cellRect(Ax + k * step, Cy + i * step, A[i][k], { fill: on ? accSoft : "var(--bg)", stroke: on ? acc : "var(--border)", sw: on ? 2 : 1, tcol: on ? acc : "var(--fg)", fw: on ? 700 : 400 });
    }

    // C (bottom-right) — the product
    s += lbl(Cx + (N * step - step + cell) / 2, Cy - 8, "C = A·B", muted);
    for (let i = 0; i < M; i++) for (let j = 0; j < N; j++) {
      const isSel = i === sel.i && j === sel.j, isFilled = filled.has(i + "," + j);
      s += cellRect(Cx + j * step, Cy + i * step, isFilled ? C[i][j] : "·", {
        fill: isSel ? "color-mix(in srgb, " + acc + " 22%, var(--surface))" : isFilled ? "color-mix(in srgb, " + acc + " 7%, var(--bg))" : "var(--bg)",
        stroke: isSel ? acc : "var(--border)", sw: isSel ? 2.5 : 1,
        tcol: isFilled ? "var(--fg)" : muted, fw: isFilled ? 800 : 400,
        cursor: true, data: ` data-i="${i}" data-j="${j}"`,
      });
    }

    // × and = glyphs
    s += `<text x="${Cx - 15}" y="${Cy + step * (M - 1) / 2 + cell / 2}" font-family="ui-monospace,monospace" font-size="18" fill="${muted}" text-anchor="middle" dominant-baseline="central">×</text>`;

    svg.setAttribute("viewBox", `0 0 ${Wd} ${Ht}`);
    svg.innerHTML = s;
    svg.querySelectorAll("g[data-i]").forEach((el) =>
      el.addEventListener("click", () => { stopPlay(); pick(+el.dataset.i, +el.dataset.j); }));
    renderCalc();
  }

  function renderCalc() {
    const { i, j } = sel;
    const terms = [];
    for (let k = 0; k < K; k++) terms.push(`<span class="ra">${A[i][k]}</span>·<span class="rb">${B[k][j]}</span>`);
    const nums = A[i].map((_v, k) => A[i][k] * B[k][j]);
    const isFilled = filled.has(i + "," + j);
    $("mm-calc").innerHTML =
      `<div class="lbl">C<sub>${i + 1}${j + 1}</sub> = (A의 ${i + 1}행) · (B의 ${j + 1}열)</div>` +
      `<div>${terms.join(" + ")}</div>` +
      `<div class="dim">= ${nums.join(" + ")}</div>` +
      `<div class="eq">= ${isFilled ? C[i][j] : "?"}</div>`;
  }

  function pick(i, j) { sel = { i, j }; filled.add(i + "," + j); draw(); renderNote(); }

  function renderNote() {
    const total = M * N;
    $("mm-note").innerHTML = filled.size >= total
      ? `4칸이 모두 채워졌습니다. <b>C의 셀 하나 = 내적 하나</b>. 행렬곱은 결국 <b>내적을 ${total}번(여기선) 한 덩어리로</b> 돌린 것뿐이에요. 실제 모델은 이걸 수백만 번, GPU로 한꺼번에 합니다.`
      : `<b>C<sub>${sel.i + 1}${sel.j + 1}</sub></b>은 A의 ${sel.i + 1}번째 행과 B의 ${sel.j + 1}번째 열의 <b>내적</b>입니다 — 0편에서 배운 그 곱하고-더하기. 나머지 칸도 눌러보세요.`;
  }

  // auto-play: walk all cells in order, filling each
  const order = [];
  for (let i = 0; i < M; i++) for (let j = 0; j < N; j++) order.push({ i, j });
  let step_i = 0;
  function stopPlay() { playing = false; if (timer) clearInterval(timer); $("mm-play").classList.remove("on"); $("mm-play").textContent = "▶ 전체 채우기"; }
  function startPlay() {
    playing = true; step_i = 0; filled.clear();
    $("mm-play").classList.add("on"); $("mm-play").textContent = "■ 정지";
    const tick = () => {
      if (step_i >= order.length) { stopPlay(); return; }
      pick(order[step_i].i, order[step_i].j); step_i++;
    };
    tick();
    timer = setInterval(tick, 600);
  }
  $("mm-play").addEventListener("click", () => { if (playing) stopPlay(); else startPlay(); });

  window.addEventListener("resize", draw);
  draw(); renderNote();
</script>
