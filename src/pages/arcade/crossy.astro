---
import BaseLayout from "../../layouts/BaseLayout.astro";
import DuelArena from "../../components/DuelArena.astro";
import { SITE } from "../../consts";
---

<BaseLayout
  title={`사람 vs 디시전 모델 — 길 건너기 — ${SITE.authorKo}`}
  description="같은 시드의 길 건너기를 왼쪽은 사람이, 오른쪽은 브라우저 안의 디시전 모델(Qwen3-0.6B 또는 Laya)이 플레이합니다. 하네스를 켜고 끄며 모델 성적이 어떻게 달라지는지 비교해 보세요."
  locale="ko"
  path="/arcade/crossy/"
>
  <header class="mb-5">
    <a href="/arcade/" class="text-sm text-muted hover:text-accent">← 오락실</a>
    <h1 class="mt-3 text-3xl font-bold tracking-tight sm:text-4xl">사람 vs 디시전 모델 — 길 건너기</h1>
    <p class="mt-3 text-muted">차를 피해 한 칸씩 길을 건넙니다. 왼쪽은 내가, 오른쪽은 <strong>디시전 모델</strong>이 같은 길을 건넙니다. 모델은 매 칸 위·왼쪽·오른쪽·아래·그대로 중 하나를 확률로 고릅니다. 90초 동안 더 멀리 간 쪽이 이깁니다. 한자리에 오래 있으면 독수리가 잡아갑니다. 조작: 방향키.</p>
  </header>

  <DuelArena game="crossy" controls={[{ move: "left", label: "◀" }, { move: "up", label: "▲" }, { move: "down", label: "▼" }, { move: "right", label: "▶" }]} />
</BaseLayout>
