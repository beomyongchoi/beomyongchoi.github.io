---
// Interactive bilingual article. Renders aligned KO/EN content split by sentence;
// each sentence is a click target that reveals its counterpart in a popover.
// A toggle switches the primary language for the whole article.
import type { BiBlock } from "../data/aiParadox";
interface Props { blocks: BiBlock[]; lang?: "ko" | "en" }
const { blocks, lang = "ko" } = Astro.props;
---

<div class="bi-article" id="bi-article" data-lang={lang}>
  <div class="bi-bar">
    <span class="bi-hint">💡 문장을 클릭하면 반대 언어 원문이 떠요 · Click any sentence for the other language</span>
    <div class="bi-toggle" role="group" aria-label="Primary language">
      <button type="button" data-lang="ko" class={lang === "ko" ? "on" : ""}>한국어</button>
      <button type="button" data-lang="en" class={lang === "en" ? "on" : ""}>English</button>
    </div>
  </div>

  {
    blocks.map((b) => {
      if (b.type === "h2") return <h2 class="bi" data-ko={b.ko} data-en={b.en} set:html={b[lang]} />;
      if (b.type === "p")
        return (
          <p>
            {b.s.map((sent, i) => (
              <Fragment>
                {i > 0 ? " " : ""}
                <span class="bi" data-ko={sent.ko} data-en={sent.en} set:html={sent[lang]} />
              </Fragment>
            ))}
          </p>
        );
      if (b.type === "quote")
        return <blockquote class="bi" data-ko={b.ko} data-en={b.en} set:html={b[lang]} />;
      if (b.type === "callout")
        return <aside class="bi-callout bi" data-ko={b.ko} data-en={b.en} set:html={b[lang]} />;
      if (b.type === "list")
        return (
          <ul>
            {b.items.map((it) => (
              <li class="bi" data-ko={it.ko} data-en={it.en} set:html={it[lang]} />
            ))}
          </ul>
        );
      if (b.type === "figure")
        return (
          <figure class="bi-fig">
            <img src={b.src} alt={b.alt} />
          </figure>
        );
      if (b.type === "hr") return <hr />;
      if (b.type === "sources") return <div class="bi-sources" set:html={b.html} />;
      return null;
    })
  }
</div>

<style is:global>
  .bi-bar {
    display: flex; align-items: center; justify-content: space-between; gap: 12px; flex-wrap: wrap;
    margin: 0 0 1.8em; padding: 10px 14px; border: 1px solid var(--border); border-radius: 12px;
    background: var(--surface);
  }
  .prose .bi-bar { margin-top: 0; }
  .bi-hint { font-size: 13px; color: var(--muted); }
  .bi-toggle { display: inline-flex; border: 1px solid var(--border); border-radius: 9px; overflow: hidden; flex-shrink: 0; }
  .bi-toggle button {
    font: inherit; font-size: 13px; font-weight: 600; padding: 5px 13px; background: transparent;
    color: var(--muted); border: 0; cursor: pointer; transition: background .15s, color .15s;
  }
  .bi-toggle button.on { background: var(--accent); color: var(--accent-fg); }

  /* sentence targets */
  .bi { cursor: pointer; border-radius: 4px; transition: background .12s; }
  .bi:hover {
    background: color-mix(in srgb, var(--accent) 9%, transparent);
    text-decoration: underline; text-decoration-style: dotted; text-underline-offset: 3px;
    text-decoration-color: color-mix(in srgb, var(--accent) 55%, transparent);
  }
  h2.bi:hover, .bi-callout:hover { text-decoration: none; }

  /* callout box (answer-first TL;DR, tips, warnings) */
  .bi-callout {
    display: block; margin: 1.7em 0; padding: 14px 18px;
    border: 1px solid var(--border); border-left: 3px solid var(--accent); border-radius: 4px 12px 12px 4px;
    background: color-mix(in srgb, var(--accent) 6%, var(--surface)); font-size: 0.97em; line-height: 1.7;
  }
  .bi-callout strong { color: var(--fg); font-weight: 700; }
  @supports not (background: color-mix(in srgb, red, blue)) { .bi-callout { background: var(--surface); } }

  .bi-peek { background: color-mix(in srgb, var(--accent) 15%, transparent); box-shadow: 0 0 0 3px color-mix(in srgb, var(--accent) 15%, transparent); }
  @supports not (background: color-mix(in srgb, red, blue)) {
    .bi:hover { background: rgba(37, 99, 235, 0.09); }
    .bi-peek { background: rgba(37, 99, 235, 0.14); box-shadow: 0 0 0 3px rgba(37, 99, 235, 0.14); }
  }

  .bi-sources h3 { font-size: 1.05rem; }
  .bi-fig img { width: 100%; }

  /* reveal popover (appended to <body>) */
  .bi-pop {
    position: absolute; z-index: 70; max-width: min(420px, 88vw); padding: 12px 15px 13px;
    border: 1px solid var(--border); border-left: 3px solid var(--accent); border-radius: 4px 13px 13px 4px;
    background: var(--bg); box-shadow: 0 14px 40px rgba(0, 0, 0, 0.28), 0 0 0 1px rgba(0, 0, 0, 0.04);
    font-size: 15px; line-height: 1.62; color: var(--fg);
  }
  .bi-pop-tag {
    display: inline-block; font-size: 10px; letter-spacing: 0.14em; font-weight: 800;
    color: var(--accent-fg); background: var(--accent); padding: 1px 7px; border-radius: 5px; margin-bottom: 8px;
  }
  .bi-pop-body strong { font-weight: 700; }
  .bi-pop-body em { font-style: italic; }
  .bi-pop-body a { color: var(--accent); }
</style>

<script>
  const article = document.getElementById("bi-article");
  if (article) {
    let primary: "ko" | "en" = article.dataset.lang === "en" ? "en" : "ko";
    let current: HTMLElement | null = null;
    const pop = document.createElement("div");
    pop.className = "bi-pop";

    const hide = () => {
      if (pop.isConnected) pop.remove();
      if (current) {
        current.classList.remove("bi-peek");
        current = null;
      }
    };

    const setLang = (lang: "ko" | "en") => {
      primary = lang;
      article.querySelectorAll<HTMLElement>(".bi").forEach((el) => {
        const html = el.dataset[lang];
        if (html != null) el.innerHTML = html;
      });
      article
        .querySelectorAll<HTMLElement>(".bi-toggle button")
        .forEach((b) => b.classList.toggle("on", b.dataset.lang === lang));
      hide();
    };

    article.querySelectorAll<HTMLElement>(".bi-toggle button").forEach((b) => {
      b.addEventListener("click", () => setLang(b.dataset.lang as "ko" | "en"));
    });

    const showFor = (span: HTMLElement, e: MouseEvent) => {
      const other = primary === "ko" ? "en" : "ko";
      const html = span.dataset[other];
      if (html == null) return;
      const label = other === "en" ? "EN · 영어 원문" : "KO · 한글 원문";
      pop.innerHTML =
        '<span class="bi-pop-tag">' + label + '</span><div class="bi-pop-body">' + html + "</div>";
      span.classList.add("bi-peek");
      current = span;
      document.body.appendChild(pop);

      const r = span.getBoundingClientRect();
      const pw = pop.offsetWidth;
      const ph = pop.offsetHeight;
      const vw = document.documentElement.clientWidth;
      let left = window.scrollX + Math.max(12, Math.min(e.clientX - 24, vw - pw - 12));
      let top = window.scrollY + r.bottom + 8;
      if (r.bottom + ph + 16 > window.innerHeight && r.top - ph - 8 > 0) {
        top = window.scrollY + r.top - ph - 8;
      }
      pop.style.left = left + "px";
      pop.style.top = top + "px";
    };

    document.addEventListener("click", (e) => {
      const target = e.target as HTMLElement;
      if (pop.contains(target)) return;
      const span = target.closest(".bi") as HTMLElement | null;
      if (span && article.contains(span) && !target.closest(".bi-toggle")) {
        if (span === current) hide();
        else showFor(span, e);
      } else {
        hide();
      }
    });
    document.addEventListener("keyup", (e) => {
      if (e.key === "Escape") hide();
    });
    document.addEventListener("scroll", hide, { passive: true });
    window.addEventListener("resize", hide);
  }
</script>
